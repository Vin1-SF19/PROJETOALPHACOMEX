+                     className="p-1 rounded-lg text-slate-500 hover:text-white hover:bg-white/10 transition-colors shrink-0"
+                   >
+                     <Plus size={13} />
+                   </button>
+                 )}
+                 <button
+                   onClick={() => toggleGroup('sistemaExterno')}
+                   aria-label="Expandir Sistema Externo"
+                   className="shrink-0"
+                 >
+                   <ChevronDown
+                     size={14}
