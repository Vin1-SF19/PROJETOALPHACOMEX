# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# vercel
.vercel

# Claude Code (worktrees + local settings)
.claude/
.cursor/worktrees/

# Fases de prompt (fila de execução local do Bibble, nunca vai para o git)
/prompt-phases/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Bundle do player de exportação HTML (Alpha Presentation Studio) — gerado por
# scripts/build-apresentacoes-player.mjs, parte do `npm run build`, nunca commitado.
/src/generated/apresentacoes-player-bundle.ts

# Database backups (sensitive; keep directory documentation only)
/database-backups/*
!/database-backups/README.md
!/database-backups/.gitkeep

# Logs do sync automático com o servidor interno (scripts/sync-servidor.ps1)
/.sync-logs/
