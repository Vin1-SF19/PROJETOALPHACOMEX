[Unit]
Description=CheckList staging - publicar eventos pendentes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ialpha
Group=ialpha
WorkingDirectory=/home/ialpha/deployments/checklist-eventos-staging/current
ExecStart=/usr/bin/node /home/ialpha/deployments/checklist-eventos-staging/current/scripts/checklist-analistas/staging-worker.mjs --once --env-file /etc/painel-alpha/checklist-eventos/.env.staging.local
TimeoutStartSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
