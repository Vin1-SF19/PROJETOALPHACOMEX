# Template sem segredos. Instalar FORA do Git como .env.staging.local, modo0600.
# O runner lê SOMENTE o arquivo explícito, sem importar process.env/.env.local.
CHECKLIST_TARGET_ENVIRONMENT=staging
CHECKLIST_PANEL_ORIGIN=https://staging.alpha-comex.com
# Copiar o fingerprint NÃO SECRETO do relatório verificado, nunca de produção.
CHECKLIST_STAGING_DATABASE_SHA256=REPLACE_WITH_VERIFIED_STAGING_DATABASE_SHA256
CHECKLIST_WORKER_SECRET=REPLACE_WITH_NEW_STAGE_ONLY_SECRET
# Opcional; preencher só se a proteção do deployment staging exigir bypass.
CHECKLIST_VERCEL_PROTECTION_BYPASS=
