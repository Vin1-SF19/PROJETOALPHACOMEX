# Segredo enviado pelo Vercel Cron no header Authorization.
CRON_SECRET=

# URL usada somente pelo comando npm run bpm:novos-leads:run.
BPM_NOVOS_LEADS_JOB_URL=http://localhost:3000

# Credenciais server-side da Service Account Google com Domain-Wide Delegation.
# O Client ID dessa conta também precisa autorizar meetings.space.readonly no Admin Console.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
## Obrigatório para o upload autenticado de anexos CRM. Use um segredo forte e
## distinto do token de escrita do Blob em cada ambiente.
CRM_ANEXO_RECEIPT_SECRET=

# Tag exata do Qwen 3.8 usada pelo Roadmap Alpha. URL e token permanecem
# nas variáveis server-side BIBBLE_OLLAMA_URL e OLLAMA_API_KEY já existentes.
ROADMAP_QWEN_MODEL=

# Modelo padrão do chat do Bibble (Ollama). Default no código: qwen3.8:latest.
BIBBLE_MODEL=

# Janela de contexto e teto de saída usados SOMENTE quando há anexo (PDF/doc)
# no chat do Bibble. Servidor Ollama roda em GPU com VRAM alta — ajuste para
# baixo aqui se o hardware mudar. Defaults no código: 131072 / 16384.
BIBBLE_ATTACHMENT_CONTEXT_WINDOW=
BIBBLE_ATTACHMENT_OUTPUT_TOKENS=

# O Roadmap descobre automaticamente os binários nativos. Use estes overrides
# somente quando Codex ou Claude estiverem instalados em um caminho diferente.
ROADMAP_CODEX_CLI_PATH=
ROADMAP_CLAUDE_CLI_PATH=

# Habilita a UI/actions de Produção somente no executor local persistente.
# Mantenha ausente ou false no ambiente hospedado/serverless.
ROADMAP_PRODUCTION_ENABLED=false

# Storage Alpha (somente servidor). Nunca use NEXT_PUBLIC_ nestas variáveis.
# Endpoint S3 público entregue pelo Cloudflare Tunnel.
STORAGE_QUOBJECTS_ENDPOINT=https://storage-poc.alpha-comex.com
# Endpoint interno opcional para processos autorizados dentro da rede.
STORAGE_QUOBJECTS_INTERNAL_ENDPOINT=
STORAGE_QUOBJECTS_REGION=us-east-1
STORAGE_QUOBJECTS_ACCESS_KEY_ID=
STORAGE_QUOBJECTS_SECRET_ACCESS_KEY=
STORAGE_QUOBJECTS_SPACE=painel-alpha-poc
STORAGE_QUOBJECTS_BUCKET=pa-poc-private

# Fallback existente do Vercel Blob. Se o token dedicado ficar vazio, o runtime
# aceita BLOB_READ_WRITE_TOKEN para compatibilidade com o store legado.
STORAGE_VERCEL_BLOB_TOKEN=
STORAGE_VERCEL_STORE=legacy-default
STORAGE_VERCEL_ACCESS=public

# Limites operacionais do multipart. Uma parte nunca pode exceder 95 MiB.
STORAGE_PREFLIGHT_TIMEOUT_MS=5000
STORAGE_MULTIPART_PART_SIZE_MIB=64
STORAGE_MULTIPART_CONCURRENCY=3
STORAGE_MULTIPART_MAX_RETRIES=3

# Alpha SEO — provedores server-side. Nunca exponha estas variaveis com NEXT_PUBLIC_.
# DataForSEO aceita uma API key Basic pronta OU o par login/senha.
DATAFORSEO_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenRouter atende Brand Lookup, Prompt Explorer e o agente SAM.
OPENROUTER_API_KEY=
ALPHA_SEO_OPENROUTER_CHATGPT_MODEL=openai/gpt-4.1-mini
ALPHA_SEO_OPENROUTER_CLAUDE_MODEL=anthropic/claude-3.7-sonnet
ALPHA_SEO_OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash
ALPHA_SEO_OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar
ALPHA_SEO_SAM_MODEL=openai/gpt-4.1-mini

# OAuth Google para Search Console e GA4. Cadastre exatamente estes callbacks:
# /api/alpha-seo/oauth/gsc/callback e /api/alpha-seo/oauth/ga4/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave de 32 bytes codificada em base64; use uma chave dedicada por ambiente.
ALPHA_SEO_GOOGLE_TOKEN_ENCRYPTION_KEY=

# CLI/operacao. O checkout fonte e opcional quando estiver em ../open-seo-main.
ALPHA_SEO_SOURCE_ROOT=
ALPHA_SEO_QUEUE_MODE=persistent-db
ALPHA_SEO_LOCK_MODE=persistent-db

# MCP Streamable HTTP. Em produção, informe a URL pública e hosts adicionais
# apenas quando necessários; localhost já é permitido no desenvolvimento.
ALPHA_SEO_MCP_PUBLIC_URL=
ALPHA_SEO_MCP_ALLOWED_HOSTS=

# Segredo compartilhado enviado pelo NoLoss no header x-noloss-webhook-secret
# em POST /api/bpm/noloss-leads/ingest (leads do site → coluna "Novos leads"
# do pipeline "Revisão de Radar"). Sem esta variável, o endpoint bloqueia tudo.
NOLOSS_WEBHOOK_SECRET=
TOKEN_CALLIX=
CALLIX_BASE_URL=
