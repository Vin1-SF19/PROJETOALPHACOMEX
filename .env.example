# Segredo enviado pelo Vercel Cron no header Authorization.
CRON_SECRET=

# URL usada somente pelo comando npm run bpm:novos-leads:run.
BPM_NOVOS_LEADS_JOB_URL=http://localhost:3000

# Credenciais server-side da Service Account Google com Domain-Wide Delegation.
# O Client ID dessa conta também precisa autorizar meetings.space.readonly no Admin Console.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
## Obrigatório para o upload autenticado de anexos CRM. Use um segredo forte e
## distinto do token de escrita do Blob em cada ambiente.
CRM_ANEXO_RECEIPT_SECRET=

# Tag exata do Qwen 3.8 usada pelo Roadmap Alpha. URL e token permanecem
# nas variáveis server-side BIBBLE_OLLAMA_URL e OLLAMA_API_KEY já existentes.
ROADMAP_QWEN_MODEL=

# O Roadmap descobre automaticamente os binários nativos. Use estes overrides
# somente quando Codex ou Claude estiverem instalados em um caminho diferente.
ROADMAP_CODEX_CLI_PATH=
ROADMAP_CLAUDE_CLI_PATH=
