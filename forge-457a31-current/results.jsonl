{"gate": "tsc", "command": "npx tsc --noEmit", "exit": 2}
{"gate": "typecheck", "command": "npm run typecheck", "exit": 1}
{"gate": "lint", "command": "npm run lint", "exit": 1}
{"gate": "build", "command": "npm run build", "exit": 0}
{"gate": "prisma", "command": "DATABASE_URL=file:./forge-validation.db npx --no-install prisma validate", "exit": 0}
{"gate": "scoped-lint", "command": "npx --no-install eslint src/actions/bpm/Checklists.ts src/lib/bpm/checklists/*.ts src/components/bpm/checklists/*.tsx src/components/bpm/checklists/checklist-editor-state.ts tests/bpm/checklists-*.test.ts", "exit": 0}
{"gate": "scoped-tests", "command": "npx --no-install vitest run tests/bpm/checklists-*.test.ts", "exit": 0}
{"gate": "tests", "command": "npm test", "exit": 1}
