  tipo              String // comissoes|premios|comissao_dsr|todos
  colaboradorId     Int?
  periodoInicio     DateTime
  periodoFim        DateTime
  formato           String // PDF|XLSX|AMBOS
  codigoVerificacao String   @unique
  hash              String
  geradoPorId       Int
  createdAt         DateTime @default(now())

  itens ExportDocumentItem[]
}

model ExportDocumentItem {
  id         String         @id @default(cuid())
  documentId String
  document   ExportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entryId    String?
  linhaJson  String
}

model Holiday {
  id        String   @id @default(cuid())
  data      DateTime
  nome      String
  escopo    String // NACIONAL|ESTADUAL|MUNICIPAL
  uf        String?
  municipio String?

  @@index([data])
}

model CommissionAuditLog {
  id            String   @id @default(cuid())
  userId        Int
  acao          String
  entityType    String
  entityId      String
  beforeJson    String?
  afterJson     String?
  reason        String?
  ipAddress     String?
  userAgent     String?
  correlationId String
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([correlationId])
}

/**
 * RBAC granular por ação dentro do módulo de Comissões — substitui a checagem hardcoded
 * `ROLES_TEMPORARIAMENTE_PERMITIDOS` presente em 12 Server Actions. Categoria (não ação
 * individual — 33 funções reais agrupadas em 6 categorias funcionais, decisão do usuário):
 * VISUALIZAR (listar/ver detalhes), SINCRONIZAR, PAGAR (registrar/programar/estornar/lote),
 * APROVAR (eventos/divergências/ajustes), CONFIGURAR (cargos/tarifários/regras/feriados/
 * exceções), EXPORTAR. Admin/CEO sempre têm acesso total, independente desta tabela
 * (bypass já existente em todo o módulo, mantido).
 */
model CommissionPermission {
  id        String   @id @default(cuid())
  userId    Int
  categoria String // VISUALIZAR|SINCRONIZAR|PAGAR|APROVAR|CONFIGURAR|EXPORTAR
  permitido Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoria])
  @@index([userId])
}

model ChecklistDocumental {
  id        String   @id @default(cuid())
  usuarioId Int      @unique
  usuario   usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  carteiraTrabalho      Boolean @default(false)
  pis                   Boolean @default(false)
  identidade            Boolean @default(false)
  cpfDoc                Boolean @default(false)
  cnh                   Boolean @default(false)
  tituloEleitor         Boolean @default(false)
  reservista            Boolean @default(false)
  comprovanteResidencia Boolean @default(false)
  certidao              Boolean @default(false)
  foto3x4               Boolean @default(false)
  exameAdmissional      Boolean @default(false)
  escolaridade          Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("checklist_documental")
}

// ─── Bibble Chat ──────────────────────────────────────────────────────────────

model BibbleProject {
  id           String          @id @default(cuid())
  userId       Int
  title        String
  systemPrompt String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     BibbleSession[]
  user         usuarios        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bibble_project")
}

model BibbleSession {
  id            String          @id @default(cuid())
  userId        Int
  title         String          @default("Nova conversa")
  projectId     String?
  // Sessão Onyx vinculada (quando a conversa é com um agente Onyx). É a fonte de
  // verdade do histórico dessa conversa — texto + imagens vêm do Onyx via
  // GET /chat/get-chat-session/{id}. NULL = conversa Bibble/Ollama (histórico local).
  onyxSessionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      BibbleMessage[]
  user          usuarios        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       BibbleProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("bibble_session")
}

model BibbleMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String
  content   String
  tokens    Int?
  createdAt DateTime      @default(now())
  session   BibbleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("bibble_message")
}

// ─── Onyx ─────────────────────────────────────────────────────────────────────
// Vincula cada agente criado no Onyx (conta de serviço única) ao usuário do
// PainelAlpha que o criou. Permite filtrar/gerenciar agentes por dono sem
// precisar criar usuários no Onyx.
model OnyxAgentOwner {
  id          Int      @id @default(autoincrement())
  onyxAgentId Int      @unique
  userId      Int
  agentName   String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("onyx_agent_owner")
}

// Agentes fixados pelo usuário no chat IAlpha (máx. 3). Segue o usuário entre dispositivos.
model OnyxAgenteFixado {
  id          Int      @id @default(autoincrement())
  userId      Int
  onyxAgentId Int
  agentName   String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, onyxAgentId])
  @@index([userId])
  @@map("onyx_agente_fixado")
}

// ─── Parceiros ────────────────────────────────────────────────────────────────

model Parceiro {
  id                                  Int                     @id @default(autoincrement())
  tipo                                String // "PF" | "PJ"
  tipoParceiro                        String                  @default("PADRAO") // "PADRAO" | "SEM_COMISSAO" | "ESPECIAL"
  documento                           String                  @unique
  nome                                String
  nomeFantasia                        String?
  dataNascimento                      String? // só preenchido quando tipo=PF
  sobre                               String? // "fale mais sobre você/sua empresa" — herdado do pré-cadastro (convite)
  email                               String
  nomeBanco                           String?
  agencia                             String?
  conta                               String?
  chavePix                            String?
  tipoChavePix                        String?
  pixConfirmado                       Boolean                 @default(false)
  pixConfirmadoEm                     DateTime?
  nivel                               String                  @default("GOLD")
  nivelAtualizadoEm                   DateTime? // base da janela de 60 dias (promoção/rebaixamento) — regra FINANCEIRA, nunca reaproveitar para inatividade de relacionamento
  comissaoPercentual                  Float? // override manual opcional (lógica futura)
  dadosConsulta                       String?
  telefone                            String?
  telefone2                           String?
  loginEmail                          String
  senhaHash                           String
  // ─── CRM de Canais e Parcerias — Desenvolvimento do Parceiro (ciclo de vida pós-cadastro) ──
  estagioDesenvolvimento              String                  @default("NOVO") // NOVO|EM_ATIVACAO|ATIVADO_SEM_INDICACAO|PRIMEIRA_INDICACAO|ATIVO|RECORRENTE|INATIVO|EM_REATIVACAO
  estagioDesenvolvimentoAtualizadoEm  DateTime?
  // RM-2026-2C7A4B — próxima ação de relacionamento (Kanban de Desenvolvimento), mesmo padrão
  // já usado em ParceiroLead.proximaAcaoEm/proximaAcaoDescricao (Aquisição).
  proximaAcaoEm                       DateTime?
  proximaAcaoDescricao                String?
  // Score MANUAL de 0 a 5 (0=sem potencial, 5=estratégico) — preenchido na qualificação, nunca
  // calculado automaticamente. Distinto de `nivel` (calculado por contratação) e de
  // `comissaoPercentual` (regra financeira) — nunca misturar os três.
  potencialRecorrencia                Int?
  potencialRecorrenciaAtualizadoEm    DateTime?
  potencialRecorrenciaAtualizadoPorId Int?
  potencialRecorrenciaAtualizadoPor   usuarios?               @relation("ParceiroPotencialAtualizadoPor", fields: [potencialRecorrenciaAtualizadoPorId], references: [id], onDelete: SetNull)
  segmento                            String?
  origem                              String?
  responsavelId                       Int?
  responsavel                         usuarios?               @relation("ParceiroResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  // ─── Onboarding / termo de adesão (portal AlphaParceiros) ──────────────────
  senhaTemporaria                     Boolean                 @default(true)
  onboardingCompleto                  Boolean                 @default(false)
  termoAceito                         Boolean                 @default(false)
  termoAceitoEm                       DateTime?
  termoVersao                         String?
  // ─── Ativação de acesso (admin pode desativar sem excluir o cadastro) ──────
  ativo                               Boolean                 @default(true)
  desativadoEm                        DateTime?
  desativadoPorId                     Int?
  criadoPorId                         Int
  criadoPor                           usuarios                @relation(fields: [criadoPorId], references: [id])
  endereco                            ParceiroEndereco?
  representantes                      ParceiroRepresentante[]
  indicacoes                          Indicacao[]
  convitesGerados                     ConviteParceiro[]       @relation("ConvitesPorParceiro")
  pessoasVinculadas                   PessoaParceiroVinculo[]
  historico                           ParceiroHistorico[]
  tarefas                             ParceiroTarefa[]
  leadsOrigem                         ParceiroLead[]          @relation("ParceiroLeadPromovido")
  createdAt                           DateTime                @default(now())
  updatedAt                           DateTime                @updatedAt

  @@index([documento])
  @@index([criadoPorId])
  @@index([estagioDesenvolvimento])
  @@index([responsavelId])
  @@map("parceiros")
}

// Histórico de relacionamento do Parceiro (Desenvolvimento) — contatos, reuniões, mudança de
// etapa/responsável/potencial, indicações, contratos, ativação/reativação. Segue o mesmo padrão
// FK-direta já usado por `BpmCardHistorico`/`ClienteServicoHistorico` (não polimórfico).
model ParceiroHistorico {
  id                String    @id @default(cuid())
  parceiroId        Int
  parceiro          Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  acao              String
  valorAnteriorJson String?
  valorNovoJson     String?
  usuarioId         Int?
  usuario           usuarios? @relation("ParceiroHistoricoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  automacaoOrigem   String?
  createdAt         DateTime  @default(now())

  @@index([parceiroId])
  @@index([createdAt])
  @@map("parceiro_historico")
}

// Tarefa vinculada a um Parceiro (Desenvolvimento) — RM-2026-8B7DC7. Não reaproveita `BpmTarefa`
// porque esta está fisicamente amarrada a `cardId` (BpmCard/CRM) como FK obrigatória; forçar isso
// aqui exigiria um card fantasma por parceiro, rejeitado. Mesma paleta de prioridade/status de
// `BpmTarefa` para consistência visual entre módulos. `origemAutomatica`/`alertaOrigemTipo`
// marcam tarefas geradas por `ListarAlertasParceiros` (idempotente por parceiroId+tipo+PENDENTE),
// distinguindo-as das criadas manualmente na tela 360º/Dashboard.
model ParceiroTarefa {
  id               String    @id @default(cuid())
  parceiroId       Int
  parceiro         Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  titulo           String
  descricao        String?
  responsavelId    Int?
  responsavel      usuarios? @relation("ParceiroTarefaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  prazo            DateTime?
  prioridade       String    @default("NORMAL") // "BAIXA" | "NORMAL" | "ALTA"
  status           String    @default("PENDENTE") // "PENDENTE" | "CONCLUIDA"
  origemAutomatica Boolean   @default(false)
  alertaOrigemTipo String? // AlertaParceiro.tipo, só quando origemAutomatica=true

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidaEm DateTime?

  @@index([parceiroId])
  @@index([status])
  @@index([responsavelId])
  @@map("parceiro_tarefa")
}

// Staging de Aquisição de Parceiros ("card virtual") — mesmo padrão em produção de `NolossLead`:
// dado externo/lead ainda NÃO é um `Parceiro` real. Kanban visual mescla estes registros com o
// funil de aquisição; promoção explícita (nunca automática) cria o `Parceiro` de verdade via
// `criarParceiro()`, preservando idempotência (CAS por `status`) e checagem de duplicidade por
// documento antes de promover.
model ParceiroLead {
  id        String  @id @default(cuid())
  status    String  @default("NOVO_LEAD") // NOVO_LEAD|EM_PROSPECCAO|CONTATO_REALIZADO|EM_QUALIFICACAO|REUNIAO_AGENDADA|REUNIAO_REALIZADA|NEGOCIACAO_FOLLOWUP|AGUARDANDO_CADASTRO|PRE_CADASTRO|CADASTRADO|STANDBY|SEM_PERFIL|PERDIDO
  tipo      String? // "PF" | "PJ", se já souber
  documento String? // CPF/CNPJ, se já coletado — checado contra `Parceiro.documento` antes de promover
  nome      String
  email     String?
  telefone  String?
  segmento  String?
  origem    String?
  cidade    String?
  uf        String?

  // ─── Cadastro completo (mesmos campos de `Parceiro`) ────────────────────────
  // Preenchidos quando o lead é criado pelo formulário completo (igual ao "Novo
  // Parceiro"), mas SEM criar login/senha nem vínculo real — fica só no card
  // virtual do funil de Aquisição até uma promoção manual (`PromoverLeadParaParceiro`).
  nomeFantasia        String?
  tipoParceiro        String? // "PADRAO" | "SEM_COMISSAO" | "ESPECIAL"
  dataNascimento      String? // só quando tipo=PF
  chavePix            String?
  tipoChavePix        String?
  nomeBanco           String?
  agencia             String?
  conta               String?
  comissaoPercentual  Float?
  dadosConsulta       String?
  // Endereço (achatado no próprio lead — não é entidade própria como
  // `ParceiroEndereco`, é só rascunho até a promoção).
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  // Responsáveis físicos (PJ) — array JSON de {nome,cpf,dataNascimento,cargo,email,telefone},
  // mesmo formato do input `responsaveis` de `criarParceiro`. Fica como JSON (não uma tabela
  // relacional) porque é só rascunho do lead, não a entidade `Pessoa` real usada pelo parceiro.
  responsaveisJson    String?

  responsavelId Int?
  responsavel   usuarios? @relation("ParceiroLeadResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  // Mesmo conceito de `Parceiro.potencialRecorrencia` — preenchível já na qualificação e
  // propagado ao `Parceiro` real na promoção (não se perde).
  potencialRecorrencia Int?

  proximaAcaoEm        DateTime?
  proximaAcaoDescricao String?

  motivoSaidaLateral String? // preenchido só quando status ∈ {STANDBY, SEM_PERFIL, PERDIDO}

  // Preenchidos só ao promover — mesmo padrão de `NolossLead.promotedClienteId/promotedAt/promotedByUserId`
  promovidoParceiroId Int?
  promovidoParceiro   Parceiro? @relation("ParceiroLeadPromovido", fields: [promovidoParceiroId], references: [id], onDelete: SetNull)
  promovidoEm         DateTime?
  promovidoPorUserId  Int?
  promovidoPorUser    usuarios? @relation("ParceiroLeadPromovidoPor", fields: [promovidoPorUserId], references: [id], onDelete: SetNull)

  historico ParceiroLeadHistorico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([responsavelId])
  @@map("parceiro_lead")
}

model ParceiroLeadHistorico {
  id                String       @id @default(cuid())
  leadId            String
  lead              ParceiroLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  acao              String
  valorAnteriorJson String?
  valorNovoJson     String?
  usuarioId         Int?
  usuario           usuarios?    @relation("ParceiroLeadHistoricoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  automacaoOrigem   String?
  createdAt         DateTime     @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("parceiro_lead_historico")
}

// Indicação: vincula um Parceiro a uma empresa do CS&NPS (model `clientes`).
// Fonte de verdade tanto do fluxo "Nova Indicação" quanto do canal de aquisição no Metas.
model Indicacao {
  id                    Int       @id @default(autoincrement())
  parceiroId            Int
  parceiro              Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  // Migration 2026-08-26 (RM CRM-Canais-Parcerias): `clienteId` DEIXOU de ser `@unique` — uma
  // empresa pode ser indicada mais de uma vez ao longo do tempo (cada indicação é um evento
  // próprio, repetível). Antes desta migration era 1 indicação por empresa para sempre. Ver
  // `decisions.md` para o histórico completo e os call sites que dependiam da cardinalidade 1:1.
  clienteId             Int
  cliente               Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataIndicacao         DateTime  @default(now())
  status                String    @default("ATIVA") // "ATIVA" | "DESVINCULADA"
  // CRM de Canais e Parcerias (Fase 04) — vínculo explícito à oportunidade comercial real
  // (BpmCard) quando a indicação é "Direcionada ao Closer". Nunca inferir esse vínculo só por
  // `Indicacao.clienteId == BpmCard.empresaId` — uma empresa pode ter múltiplos cards ao longo
  // do tempo (inclusive de indicações diferentes, já que `clienteId` deixou de ser único).
  bpmCardId             String?   @unique
  bpmCard               BpmCard?  @relation(fields: [bpmCardId], references: [id], onDelete: SetNull)
  criadoPorId           Int
  criadoPor             usuarios  @relation("IndicacaoAutor", fields: [criadoPorId], references: [id])
  // RM-2026-97934A: produto/serviço indicado pelo parceiro, texto livre (mesmo padrão de
  // BpmCard.servico/ContratoComercial.servico), reaproveitando o catálogo do Alpha Metas
  // (SERVICOS_COMERCIAIS_PADRAO + tabela servicos_comerciais). Repassado ao BpmCard.servico
  // quando a indicação é direcionada ao closer automaticamente.
  servicoIndicado       String?
  // Comprovante de comissão (enviado no PainelAlpha, visto no portal do parceiro)
  comprovanteUrl        String?
  comprovanteNome       String?
  comprovanteTipo       String? // mime type
  comprovanteEnviadoEm  DateTime?
  comprovanteEnviadoPor String?
  createdAt             DateTime  @default(now())

  @@index([parceiroId])
  @@index([clienteId])
  @@index([dataIndicacao])
  @@map("indicacoes")
}

// Permissões do módulo de Parceiros (geridas pelo Admin via engrenagem).
// Admin/CEO sempre têm acesso total e NÃO dependem desta tabela.
model ParceiroAcesso {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)
  podeEditar  Boolean  @default(false)
  podeExcluir Boolean  @default(false)
  /// Pode aprovar/rejeitar pré-cadastros de parceiro (wizard de convite) mesmo
  /// não sendo Admin/CEO — 3º toggle da tela "Controle de Acesso"
  /// (ModalEngrenagem.tsx), ao lado de Editar/Excluir.
  podeAprovar Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("parceiro_acesso")
}

model ParceiroEndereco {
  id          Int      @id @default(autoincrement())
  parceiroId  Int      @unique
  parceiro    Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  cep         String
  logradouro  String
  numero      String?
  complemento String?
  bairro      String
  cidade      String
  uf          String

  @@map("parceiro_endereco")
}

// Representantes cadastrados pelo parceiro no portal AlphaParceiros (manual, N por parceiro).
// Mantido no schema por decisão explícita (2026-08-12, Fase 3.1b do Cliente Master) mesmo
// sem escrita nova — mesmo padrão já aplicado a `PessoaEmpresaVinculo` em 2026-08-08. O
// fluxo ativo de representante de parceiro passa a ser `Pessoa`/`PessoaParceiroVinculo`
// (papel="REPRESENTANTE"). `ParceiroResponsavel` (irmão órfão, 0 uso confirmado no código)
// foi removido nesta mesma fase.
model ParceiroRepresentante {
  id             Int      @id @default(autoincrement())
  parceiroId     Int
  parceiro       Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  tipo           String
  documento      String
  nome           String
  dataNascimento String?
  cargo          String?
  email          String?
  telefone       String?
  createdAt      DateTime @default(now())

  @@index([parceiroId])
  @@map("parceiro_representante")
}

// Termo de adesão editável pelo Admin (sem mexer no código). O parceiro lê a
// versão ATIVA no onboarding do portal. Mantém histórico de versões.
model ParceiroTermo {
  id          Int      @id @default(autoincrement())
  versao      String // ex: "v1-2026"
  conteudo    String // texto do termo (markdown/plano)
  ativo       Boolean  @default(true)
  criadoPorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("parceiro_termo")
}

// ─── Convite de parceiro (link temporário) ────────────────────────────────────
// Gera um link público com token; o convidado preenche o form → vira PreCadastro.
model ConviteParceiro {
  id                  Int                   @id @default(autoincrement())
  token               String                @unique // token do link (randomUUID)
  status              String                @default("PENDENTE") // PENDENTE | USADO | REVOGADO | EXPIRADO
  expiraEm            DateTime // validade do link
  usoUnico            Boolean               @default(true)
  // PIN de 4 dígitos — protege a consulta automática de CPF (custo por chamada
  // na InfoSimples). Nullable: convites gerados antes desta feature não têm PIN
  // e por isso NÃO liberam a busca automática (ver rota /api/convite/consulta-cpf).
  pin                 String?
  // Rate-limit de tentativas de PIN — compartilhado entre StepPin (entrada no
  // wizard) e a consulta automática de CPF. 5 tentativas erradas suspende por 1min.
  tentativasPin       Int                   @default(0)
  suspensoAte         DateTime?
  // Quem gerou: um usuário do Painel OU um parceiro existente (indicação).
  criadoPorUserId     Int?
  criadoPorParceiroId Int?
  criadoPorUser       usuarios?             @relation("ConvitesCriados", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  criadoPorParceiro   Parceiro?             @relation("ConvitesPorParceiro", fields: [criadoPorParceiroId], references: [id], onDelete: SetNull)
  preCadastros        PreCadastroParceiro[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([token])
  @@index([status])
  @@map("convite_parceiro")
}

// Respostas do formulário público (espelho do Google Forms). Fica como
// pré-cadastro até um admin aprovar e converter em Parceiro de verdade.
model PreCadastroParceiro {
  id                  Int              @id @default(autoincrement())
  conviteId           Int?
  convite             ConviteParceiro? @relation(fields: [conviteId], references: [id], onDelete: SetNull)
  // Campos do formulário
  email               String
  nomeCompleto        String
  cpf                 String?
  dataNascimento      String? // usada na consulta automática de CPF (InfoSimples)
  dadosConsultaCpf    String? // JSON bruto da resposta InfoSimples (CPF)
  uf                  String
  municipio           String?
  telefone            String
  whatsapp            String?
  // Endereço estruturado (wizard multi-tela com busca de CEP)
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  areasAtuacao        String? // CSV das áreas selecionadas
  nomeEmpresa         String? // campo legado — mantido por compatibilidade
  razaoSocial         String? // preenchido pela consulta automática de CNPJ
  nomeFantasia        String? // preenchido pela consulta automática de CNPJ
  cnpj                String?
  dadosConsultaCnpj   String? // JSON bruto da resposta ReceitaFederal (CNPJ)
  sobre               String? // "fale mais sobre você/empresa"
  tipoRecebimento     String? // "PF" | "PJ" — escolha explícita feita no wizard (Step Tipo). Null = pré-cadastros antigos, cai no fallback por CNPJ.
  souRepresentante    Boolean          @default(true) // se PJ: true = o próprio preenchedor (nomeCompleto/cpf/dataNascimento) é o representante; false = usa representantesExtra
  representantesExtra String? // JSON stringificado de { nome, cpf, dataNascimento, cargo }[] — só quando souRepresentante=false
  // Aceite do termo (versão capturada no momento do aceite)
  termoVersao         String
  termoAceito         Boolean          @default(true)
  termoAceitoEm       DateTime         @default(now())
  // Fluxo de aprovação
  status              String           @default("PENDENTE") // PENDENTE | APROVADO | REJEITADO
  parceiroId          Int? // preenchido quando aprovado (vira Parceiro)
  aprovadoPorId       Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([conviteId])
  @@map("pre_cadastro_parceiro")
}

// Config singleton do módulo Parceiros (1 linha). Controla flags globais.
model ParceiroConfig {
  id                           Int      @id @default(1)
  permitirParceiroConvidar     Boolean  @default(false)
  validadeConvitePadraoDias    Int      @default(7)
  // ─── CRM de Canais e Parcerias — regras de relacionamento configuráveis (nunca hardcoded) ──
  // null = alerta desligado. NUNCA reaproveitar a janela de 60 dias de `recalcularNivel()`
  // (regra financeira de nível) para nenhum destes campos (regra de relacionamento).
  diasAlertaSemIndicacao       Int?
  diasInatividade              Int      @default(60)
  cadenciaPotencial4Dias       Int?
  cadenciaPotencial5Dias       Int?
  // RM-2026-8B7DC7 — liga/desliga a criação automática de ParceiroTarefa a partir dos alertas
  // de ListarAlertasParceiros. Desligado por padrão (opt-in explícito do Admin).
  gerarTarefaAutomaticaAlertas Boolean  @default(false)
  updatedAt                    DateTime @updatedAt

  @@map("parceiro_config")
}

// ─── Alpha Presentation Studio ────────────────────────────────────────────────
// Editor de apresentações HTML interativas. Conteúdo de cada slide é guardado
// como JSON (Slide.dadosJson) — não relacional — decisão registrada em
// decisions.md (2026-07-09, "arquitetura de dados do slide").

model Apresentacao {
  id            String                    @id @default(cuid())
  titulo        String
  clienteNome   String?
  autorId       Int
  autor         usuarios                  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  status        String                    @default("DRAFT") // DRAFT | PUBLICADA | ARQUIVADA
  temaId        String?
  tema          ApresentacaoTema?         @relation(fields: [temaId], references: [id])
  thumbnailUrl  String?
  slugPublico   String?                   @unique
  senhaAcesso   String?
  expiraEm      DateTime?
  slides        Slide[]
  assets        ApresentacaoAsset[]
  versoes       ApresentacaoVersao[]
  colaboradores ApresentacaoColaborador[]
  comentarios   ApresentacaoComentario[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([autorId])
  @@index([status])
}

model Slide {
  id               String                   @id @default(cuid())
  apresentacaoId   String
  apresentacao     Apresentacao             @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  ordem            Int
  nome             String?
  transicaoEntrada String?
  duracaoAutoplay  Int?
  dadosJson        Json
  oculto           Boolean                  @default(false)
  comentarios      ApresentacaoComentario[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([apresentacaoId, ordem])
}

model ApresentacaoTema {
  id              String         @id @default(cuid())
  nome            String
  corPrimaria     String
  corSecundaria   String
  corAccent       String
  radius          String?
  fontePrimaria   String?
  fonteSecundaria String?
  tokensJson      Json
  isTemplate      Boolean        @default(false)
  criadoPorId     Int?
  apresentacoes   Apresentacao[]
  createdAt       DateTime       @default(now())
}

model ApresentacaoAsset {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  tipo           String // IMAGEM | VIDEO | MODELO_3D | AUDIO | FONTE
  url            String
  nomeOriginal   String
  tamanhoBytes   Int
  createdAt      DateTime     @default(now())

  @@index([apresentacaoId])
}

model ApresentacaoVersao {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  dadosJson      Json
  criadoPorId    Int
  label          String?
  createdAt      DateTime     @default(now())

  @@index([apresentacaoId, createdAt])
}

model ApresentacaoColaborador {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  userId         Int
  user           usuarios     @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel          String       @default("EDITOR") // EDITOR | VISUALIZADOR | COMENTARISTA

  @@unique([apresentacaoId, userId])
}

model ApresentacaoComentario {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  slideId        String?
  slide          Slide?       @relation(fields: [slideId], references: [id], onDelete: SetNull)
  autorId        Int
  autor          usuarios     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto          String
  resolvido      Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ─── Calendário Alpha (Google Calendar via Domain-Wide Delegation) — MVP, sem webhook/vínculos internos ───
// Ver docs/stories/story-calendario-alpha.md. Arquitetura 2026-07-17: Service Account com impersonation
// (subject = usuarios.email, que é o mesmo e-mail do Google Workspace) — NÃO há OAuth por usuário nem
// token individual a persistir/criptografar. O acesso real é concedido em bloco pelo Super Admin do
// Workspace no Admin Console; `status` aqui é só a ativação/preferência do usuário dentro do Painel.

model GoogleCalendarConexao {
  id     String   @id @default(cuid())
  userId Int      @unique
  user   usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("ATIVA") // ATIVA | DESATIVADA — não revoga o acesso do Service Account, só a exibição/uso no Painel

  ativadoEm    DateTime  @default(now())
  desativadoEm DateTime?

  ultimaSincronizacaoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarios GoogleCalendarSelecionado[]
  taskLists   GoogleCalendarTaskListCache[]

  @@index([status])
}

model GoogleCalendarSelecionado {
  id        String                @id @default(cuid())
  conexaoId String
  conexao   GoogleCalendarConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  googleCalendarId String
  nome             String
  corHex           String?
  timezone         String
  papelAcesso      String // owner | writer | reader | freeBusyReader

  visivel  Boolean @default(true)
  gravavel Boolean @default(false)

  syncToken             String?
  ultimaSincronizacaoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos           GoogleCalendarEventoCache[]
  pushChannels      GoogleCalendarPushChannel[]
  pendingOperations GoogleCalendarPendingOperation[]
  syncLease         GoogleCalendarSyncLease?

  @@unique([conexaoId, googleCalendarId])
}

/// Cache local mínimo por evento sincronizado — só o necessário para renderizar as visões e
/// suportar sync incremental por syncToken (idempotência via googleEventId). Google Calendar
/// continua sendo a fonte de verdade; descrição, participantes e link do Meet NÃO são
/// persistidos aqui e são buscados sob demanda ao abrir o detalhe do evento.
model GoogleCalendarEventoCache {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  googleEventId        String
  status               String // confirmed | tentative | cancelled
  titulo               String?
  inicioEm             DateTime?
  fimEm                DateTime?
  diaInteiro           Boolean   @default(false)
  etag                 String
  linkMeet             String?
  eventType            String    @default("default") // default | focusTime | outOfOffice | workingLocation | birthday | fromGmail
  statusPropertiesJson String?

  atualizadoGoogleEm DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([calendarioId, googleEventId])
  @@index([calendarioId, inicioEm])
  @@index([calendarioId, eventType, inicioEm])
}

/// Cache das listas Google Tasks da conexão. A Google Tasks API é uma integração
/// distinta do Calendar; o cache permite manter a Agenda Alpha cache-first.
model GoogleCalendarTaskListCache {
  id        String                @id @default(cuid())
  conexaoId String
  conexao   GoogleCalendarConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  googleTaskListId      String
  titulo                String
  ultimaSincronizacaoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarefas GoogleCalendarTaskCache[]

  @@unique([conexaoId, googleTaskListId])
  @@index([conexaoId, ultimaSincronizacaoEm])
}

/// Cache local de tarefas Google. A API Google Tasks não possui syncToken nem
/// webhook; atualizações externas entram por sincronização explícita/agendada.
model GoogleCalendarTaskCache {
  id         String                      @id @default(cuid())
  taskListId String
  taskList   GoogleCalendarTaskListCache @relation(fields: [taskListId], references: [id], onDelete: Cascade)

  googleTaskId       String
  titulo             String
  notas              String?
  status             String // needsAction | completed
  vencimentoEm       DateTime?
  concluidaEm        DateTime?
  excluida           Boolean   @default(false)
  oculta             Boolean   @default(false)
  parentGoogleTaskId String?
  posicao            String?
  atualizadoGoogleEm DateTime

  // Horário de início/fim escolhido pelo usuário na Agenda Alpha. A API do
  // Google Tasks só persiste a data de vencimento (sem hora); estas colunas
  // guardam o período localmente para exibir a tarefa como um bloco de
  // horário na grade, para tarefas criadas fora do fluxo de chamados.
  inicioLocalEm DateTime?
  fimLocalEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendamentoChamado GoogleCalendarTaskSchedule?

  @@unique([taskListId, googleTaskId])
  @@index([taskListId, status, vencimentoEm])
  @@index([taskListId, atualizadoGoogleEm])
}

/// Agendamento local de uma tarefa Google criada automaticamente para um chamado.
/// A API Google Tasks persiste a data de vencimento, mas não a hora; estas colunas
/// preservam o período exibido na Agenda Alpha e o fim real do atendimento.
model GoogleCalendarTaskSchedule {
  id              String    @id @default(cuid())
  chamadoId       Int       @unique
  tarefaCacheId   String    @unique
  usuarioAgendaId Int
  inicioEm        DateTime
  fimPlanejadoEm  DateTime
  fimConcluidoEm  DateTime?
  status          String    @default("EM_ATENDIMENTO") // EM_ATENDIMENTO | CONCLUIDO
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  chamado     chamados                @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tarefaCache GoogleCalendarTaskCache @relation(fields: [tarefaCacheId], references: [id], onDelete: Cascade)

  @@index([usuarioAgendaId, status, inicioEm])
}

/// Canal push registrado no Google Calendar. O token persistido é somente o hash usado para
/// autenticar notificações; o valor secreto nunca é armazenado em texto puro.
model GoogleCalendarPushChannel {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  googleChannelId  String  @unique
  googleResourceId String?
  resourceUri      String?
  channelTokenHash String

  status     String   @default("CREATING") // CREATING | ACTIVE | STOPPING | STOPPED | EXPIRED | ERROR
  expiresAt  DateTime
  renewAfter DateTime

  activatedAt DateTime?
  stoppedAt   DateTime?

  lastMessageNumber  String?
  lastNotificationAt DateTime?
  lastErrorCode      String?
  lastErrorAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pendingOperations GoogleCalendarPendingOperation[]

  @@index([status, renewAfter])
  @@index([calendarioId, status, expiresAt])
}

/// Fila persistente at-least-once para sincronização e manutenção de canais. O idempotencyKey
/// impede enfileiramento duplicado e claimToken oferece fencing durante reclaims.
model GoogleCalendarPendingOperation {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  pushChannelId String?
  pushChannel   GoogleCalendarPushChannel? @relation(fields: [pushChannelId], references: [id], onDelete: SetNull)

  operationType  String // SYNC_CALENDAR | RENEW_CHANNEL | STOP_CHANNEL | RECONCILE_CHANNEL
  source         String // WEBHOOK | MANUAL | SCHEDULED | ADMIN
  idempotencyKey String  @unique
  payloadJson    String?

  status       String   @default("PENDING") // PENDING | PROCESSING | RETRY | SUCCEEDED | DEAD_LETTER | CANCELLED
  priority     Int      @default(100)
  attemptCount Int      @default(0)
  maxAttempts  Int      @default(8)
  availableAt  DateTime @default(now())

  claimedBy      String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  claimToken     Int       @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?
  deadLetteredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, priority, createdAt])
  @@index([status, claimExpiresAt])
  @@index([calendarioId, operationType, status])
  @@index([pushChannelId])
}

/// Lease distribuído por calendário. O fencingToken cresce a cada aquisição para impedir que
/// workers antigos confirmem trabalho depois de perder o lease.
model GoogleCalendarSyncLease {
  id           String                    @id @default(cuid())
  calendarioId String                    @unique
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  ownerId        String
  fencingToken   Int      @default(1)
  leaseExpiresAt DateTime
  heartbeatAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseExpiresAt])
}

/// Controle de idempotência dos alertas de compromisso próximo (10min/5min antes), disparados
/// pelo cron `/api/calendario-alpha/jobs/alertas-compromissos` a cada 5min. Uma linha por
/// (evento, destinatário, janela) — o mesmo evento pode gerar 1 linha para o dono do compromisso
/// e outras para cada colega que visualiza aquela agenda (GoogleCalendarColegaVisivel.visivel).
/// googleEventId (não um FK direto pro cache) porque o alerta de um destinatário-colega não tem
/// necessariamente uma linha própria em GoogleCalendarEventoCache — todos leem o cache do DONO.
model GoogleCalendarAlertaCompromisso {
  id             String @id @default(cuid())
  calendarioId   String // GoogleCalendarSelecionado.id do calendário DONO do compromisso (fonte do cache)
  googleEventId  String
  destinatarioId Int // usuários.id de quem recebe o alerta (dono OU colega visualizador)
  janela         String // "10min" | "5min"

  notificadoEm DateTime @default(now())

  @@unique([calendarioId, googleEventId, destinatarioId, janela])
  @@index([notificadoEm])
}

/// Compartilhamento de agenda entre colegas. Desde 2026-08-17, uma linha aqui só é criada
/// depois de aprovação explícita do dono via GoogleCalendarSolicitacaoCompartilhamento — decisão
/// revertida pelo usuário (a versão anterior deste comentário dizia "não é um convite que o dono
/// aprova"; agora é exatamente isso, inclusive para Admin/CEO, sem bypass). `papel` substitui a
/// antiga visão única — VISUALIZADOR só lê a agenda do colega, EDITOR também pode criar/editar/
/// excluir eventos nela (checagem de ownership nas Server Actions de evento, não só aqui). `cor`
/// continua atribuída automaticamente na criação (mantém a lógica antiga), agora no momento em
/// que a solicitação é aprovada, não mais no clique de "adicionar".
model GoogleCalendarColegaVisivel {
  id       String  @id @default(cuid())
  userId   Int // quem está vendo (o "viewer")
  colegaId Int // o colega cuja agenda aparece na visão do viewer (o "dono")
  papel    String  @default("VISUALIZADOR") // VISUALIZADOR | EDITOR
  cor      String // hex atribuído para diferenciar este colega na grade do viewer
  visivel  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewer usuarios @relation("ColegaViewer", fields: [userId], references: [id], onDelete: Cascade)
  colega usuarios @relation("ColegaDono", fields: [colegaId], references: [id], onDelete: Cascade)

  @@unique([userId, colegaId])
  @@index([colegaId])
}

/// Solicitação de compartilhamento de agenda — fluxo de convite/aprovação (substituiu o acesso
/// direto antigo, decisão de 2026-08-17). `solicitanteId` pede para ver/editar a agenda de
/// `alvoId`; só o `alvoId` pode aprovar/recusar. Ao aprovar, a Server Action cria a linha
/// correspondente em GoogleCalendarColegaVisivel com o `papel` pedido — esta tabela nunca vira
/// a fonte de verdade de acesso, só o histórico/estado do pedido (mesmo espírito de
/// ConviteParceiro→PreCadastroParceiro→aprovação→entidade real, adaptado para 2 usuários já
/// autenticados, sem token público).
model GoogleCalendarSolicitacaoCompartilhamento {
  id            String    @id @default(cuid())
  solicitanteId Int
  alvoId        Int
  papelPedido   String // VISUALIZADOR | EDITOR
  status        String    @default("PENDENTE") // PENDENTE | ACEITO | RECUSADO
  respondidoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitante usuarios @relation("SolicitacaoCompartilhamentoOrigem", fields: [solicitanteId], references: [id], onDelete: Cascade)
  alvo        usuarios @relation("SolicitacaoCompartilhamentoAlvo", fields: [alvoId], references: [id], onDelete: Cascade)

  @@index([alvoId, status])
  @@index([solicitanteId, status])
}

/// Permissão administrativa para usar o compartilhamento de agenda entre colegas (Calendário
/// Alpha). Presença de uma linha = usuário permitido a adicionar/ser adicionado por colegas.
/// Admin/CEO sempre tem acesso pleno independente desta tabela (ver `isAdminRole`).
model GoogleCalendarPermissaoColegas {
  userId       Int      @id
  user         usuarios @relation("PermissaoColegasCalendario", fields: [userId], references: [id], onDelete: Cascade)
  concedidoPor Int
  createdAt    DateTime @default(now())
}

// ─── Alpha Blueprint (central de especificação de sistemas) ──────────────────
// Aprovado por Vault em 2026-07-27 (🟢 — 9 CREATE TABLE novas, sem alteração
// em tabela existente). Ver blueprint completo do Scout / aprovação do Vault
// no journal desta sessão.

model BlueprintProject {
  id        String  @id @default(cuid())
  code      String  @unique
  title     String
  slug      String?
  summary   String?
  problem   String?
  objective String?

  status              String  @default("IDEA")
  priority            String  @default("NORMAL")
  progress            Int     @default(0)
  progressDetailsJson String?

  setor       String?
  requesterId Int
  ownerId     Int?
  developerId Int?

  dueDate     DateTime?
  coverUrl    String?
  icon        String?
  tagsJson    String?
  premioCents Int?

  createdById Int
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  documents    BlueprintDocument[]
  boards       BlueprintBoard[]
  files        BlueprintFile[]
  requirements BlueprintRequirement[]
  questions    BlueprintQuestion[]
  comments     BlueprintComment[]
  members      BlueprintMember[]
  activities   BlueprintActivity[]

  requester usuarios  @relation("BlueprintRequester", fields: [requesterId], references: [id])
  owner     usuarios? @relation("BlueprintOwner", fields: [ownerId], references: [id])
  developer usuarios? @relation("BlueprintDeveloper", fields: [developerId], references: [id])
  createdBy usuarios  @relation("BlueprintCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([priority])
  @@index([setor])
  @@index([requesterId])
  @@index([ownerId])
  @@index([updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Sistema de Notas — camada global (Fase 01, prompt-phases/SistemaDeNotas)
// ─────────────────────────────────────────────────────────────────────────

model Note {
  id             String    @id @default(cuid())
  title          String
  contentJson    Json
  plainText      String
  ownerId        Int
  visibility     String // PRIVADA | COMPARTILHADA | EQUIPE | INSTITUCIONAL
  status         String    @default("ATIVA") // RASCUNHO | ATIVA | ARQUIVADA | LIXEIRA
  color          String?
  icon           String?
  isFavorite     Boolean   @default(false)
  isPinned       Boolean   @default(false)
  currentVersion Int       @default(1)
  createdById    Int
  updatedById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?

  owner     usuarios  @relation("NoteOwner", fields: [ownerId], references: [id])
  createdBy usuarios  @relation("NoteCreatedBy", fields: [createdById], references: [id])
  updatedBy usuarios? @relation("NoteUpdatedBy", fields: [updatedById], references: [id])

  contexts    NoteContext[]
  permissions NotePermission[]
  teamShares  NoteTeamShare[]
  tags        NoteTag[]
  versions    NoteVersion[]
  comments    NoteComment[]
  attachments NoteAttachment[]
  reminders   NoteReminder[]
  openTabs    UserOpenNoteTab[]

  @@index([ownerId, status])
  @@index([status, deletedAt])
  @@index([visibility])
  @@index([updatedAt])
  @@index([isPinned])
}

model NoteContext {
  id           String   @id @default(cuid())
  noteId       String
  moduleKey    String
  entityType   String
  entityId     String
  displayName  String
  internalPath String
  metadata     Json?
  createdAt    DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([moduleKey, entityType, entityId])
  @@index([noteId])
}

model NotePermission {
  id          String   @id @default(cuid())
  noteId      String
  subjectType String // USUARIO | SETOR | ROLE
  subjectId   String
  role        String // LEITOR | COMENTARISTA | EDITOR | ADMIN
  createdById Int
  createdAt   DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdBy usuarios @relation("NotePermissionCreatedBy", fields: [createdById], references: [id])

  @@unique([noteId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model NoteTeam {
  id        String   @id @default(cuid())
  name      String
  nameKey   String
  ownerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   usuarios         @relation("NoteTeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members NoteTeamMember[]
  shares  NoteTeamShare[]

  @@unique([ownerId, nameKey])
  @@index([ownerId])
}

model NoteTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    Int
