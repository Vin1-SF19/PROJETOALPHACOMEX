}

/// Confirmação de leitura de um documento do POP por um usuário — 1 linha por
/// par (documento, usuário). Alimenta o botão "Confirmar Leitura" no POP e o
/// indicador de documentos lidos no card de cada colaborador em Gestão de
/// Equipe. Criada via script pontual (Vault aprovou 🟢, CREATE TABLE puro),
/// não via `prisma db push` (não alcança o Turso remoto neste projeto).
model ConfirmacaoLeituraDocumento {
  id           Int      @id @default(autoincrement())
  documentoId  Int
  usuarioId    Int
  confirmadoEm DateTime @default(now())

  documento documentos @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   usuarios   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([documentoId, usuarioId])
  @@index([usuarioId])
  @@index([documentoId])
}

// `model clientes`, `socios`, `log_cs`, `logFeedback` removidos em 2026-08-14
// (Fase 3.6 do Cliente Master) — substituídos por `Cliente`+`ClienteServico`
// (empresa + serviço contratado, separados) e `Pessoa`+`PessoaClienteVinculo`
// (sócios, celular como chave, global). `logAlteracao` (699 linhas, nunca escrita
// por nenhuma action, só lida na exportação Excel) preservada como histórico morto
// na tabela física do Turso, sem equivalente novo no schema — decisão do usuário
// 2026-08-14.

/// Reconstrução do log de auditoria do CS&NPS (2026-07-13, ver decisions.md).
/// Substitui `logAlteracao` (desativado, sem gravação nova) por granularidade
/// por campo: cada campo alterado em 1 "Salvar" vira 1 linha, agrupadas por
/// `loteId`. Reversão é por linha/campo específico, nunca o cliente inteiro.
// Fase 3.6 do Cliente Master (2026-08-14): passou a pendurar em `Cliente` (dados
// cadastrais: razaoSocial/nomeFantasia/uf/municipio/regimeTributario/dataConstituicao/
// cnpj), não mais em `clientes` (legado). Histórico de campos de NEGÓCIO (status,
// analistaResponsavel, dataContratacao, etc) vive em `ClienteServicoHistorico`,
// pendurado em `clienteServicoId` — são dois históricos por natureza (decisão do
// usuário 2026-08-14).
model HistoricoAlteracaoCliente {
  id                 String    @id @default(cuid())
  loteId             String // agrupa todas as linhas de 1 mesma ação de "Salvar"
  clienteId          Int
  cliente            Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campo              String // nome do campo alterado (ex: "razaoSocial", "nomeFantasia")
  valorAnterior      String?
  valorNovo          String?
  userId             Int?
  usuario            usuarios? @relation(fields: [userId], references: [id], onDelete: SetNull)
  nomeUsuarioNaEpoca String // snapshot do nome no momento da ação
  acao               String    @default("EDICAO") // "EDICAO" | "REVERSAO"
  criadoEm           DateTime  @default(now())

  @@index([clienteId, criadoEm])
  @@index([loteId])
  @@map("historico_alteracao_cliente")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTE MASTER (2026-08-12, ver .bibble/memory/plano-cliente-master.md)
// Fase 2 — schema novo em paralelo aos models antigos (clientes/socios etc.),
// sem remover nada ainda. Cliente = empresa (1 linha por CNPJ). ClienteServico
// = o que hoje vive dentro de `clientes` (status/analista/dataExito/valor).
// Pessoa = pessoa física global (celular como chave), N:N com Cliente E Parceiro.
// ═══════════════════════════════════════════════════════════════════════════

model Cliente {
  id                Int     @id @default(autoincrement())
  cnpj              String? @unique // nullable — empresa "em constituição" sem CNPJ ainda (ver decisions.md pergunta 11)
  razaoSocial       String
  nomeFantasia      String?
  dataConstituicao  String?
  uf                String?
  municipio         String?
  regimeTributario  String?
  capitalSocial     String?
  situacaoCadastral String?
  status            String  @default("ATIVO") // ATIVO | ARQUIVADO — status da EMPRESA, não de um serviço

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicos              ClienteServico[]
  pessoas               PessoaClienteVinculo[]
  indicacoes            Indicacao[]
  bpmCards              BpmCard[]
  extratos              Extratos?
  consultaPreAnalise    ConsultaPreAnalise?
  operacionalClientes   OperacionalClientes[]
  contratosComerciais   ContratoComercial[]
  historicoAlteracoes   HistoricoAlteracaoCliente[]
  commissionEvents      CommissionEvent[]
  businessProcesses     BusinessProcess[]
  eligibilityOverrides  EligibilityOverride[]
  nolossLeadsPromovidos NolossLead[]
  documentosGerados     DocumentoGerado[]

  @@index([razaoSocial])
  @@index([status])
}

model ClienteServico {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  servico             String
  status              String  @default("Em Andamento")
  analistaResponsavel String?
  dataContratacao     String?
  dataExito           String?
  formaPagamento      String?
  valorContrato       Float?
  closerNome          String?
  ultimoCs            Int?    @default(0)
  nps                 Int?
  feedbackGoogle      Boolean @default(false)
  nomeGoogle          String?
  embasamento         String?
  origemLead          String?
  canalAquisicao      String?
  canalOutro          String?

  logCs                ClienteServicoLogCs[]
  logFeedback          ClienteServicoLogFeedback[]
  historicoAlteracoes  ClienteServicoHistorico[]
  commissionEvents     CommissionEvent[]
  businessProcesses    BusinessProcess[]
  eligibilityOverrides EligibilityOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, servico])
  @@index([status])
}

model ClienteServicoLogCs {
  id               String         @id @default(cuid())
  dataRegistro     DateTime       @default(now())
  colaborador      String
  sentimento       String
  observacao       String?
  clienteServicoId Int
  clienteServico   ClienteServico @relation(fields: [clienteServicoId], references: [id], onDelete: Cascade)

  @@index([clienteServicoId])
}

model ClienteServicoLogFeedback {
  id               String         @id @default(cuid())
  dataRegistro     DateTime       @default(now())
  colaborador      String
  sentimento       String
  observacao       String?
  clienteServicoId Int
  clienteServico   ClienteServico @relation(fields: [clienteServicoId], references: [id], onDelete: Cascade)

  @@index([clienteServicoId])
}

/// Sucessora de HistoricoAlteracaoCliente, penduradas em ClienteServico (decisão da
/// pergunta 2 do plano — Opção B). Mesma granularidade por campo + agrupamento por loteId.
model ClienteServicoHistorico {
  id                 String         @id @default(cuid())
  loteId             String
  clienteServicoId   Int
  clienteServico     ClienteServico @relation(fields: [clienteServicoId], references: [id], onDelete: Cascade)
  campo              String
  valorAnterior      String?
  valorNovo          String?
  userId             Int?
  usuario            usuarios?      @relation("ClienteServicoHistoricoUsuario", fields: [userId], references: [id], onDelete: SetNull)
  nomeUsuarioNaEpoca String
  acao               String         @default("EDICAO")
  criadoEm           DateTime       @default(now())

  @@index([clienteServicoId, criadoEm])
  @@index([loteId])
}

/// Pessoa física global — celular como chave, N:N com Cliente (empresa) e com
/// Parceiro. Substitui `socios` (1:N preso a 1 cliente) e `ParceiroResponsavel`/
/// `ParceiroRepresentante` (decisão do usuário, 2026-08-08, pergunta 10).
model Pessoa {
  id             Int     @id @default(autoincrement())
  celular        String  @unique
  nome           String
  cpf            String?
  dataNascimento String?
  email          String?
  telefoneExtra  String?
  observacao     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vinculos         PessoaClienteVinculo[]
  vinculosParceiro PessoaParceiroVinculo[]

  @@index([nome])
}

model PessoaClienteVinculo {
  id        Int     @id @default(autoincrement())
  pessoaId  Int
  pessoa    Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  vinculo   String?
  cargo     String?
  principal Boolean  @default(false)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  @@unique([pessoaId, clienteId])
  @@index([clienteId])
  @@index([pessoaId])
}

/// Substitui ParceiroResponsavel/ParceiroRepresentante (decisão 2026-08-08). `papel`
/// distingue os 2 tipos herdados ("RESPONSAVEL_LEGAL" | "REPRESENTANTE").
model PessoaParceiroVinculo {
  id         Int      @id @default(autoincrement())
  pessoaId   Int
  pessoa     Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  parceiroId Int
  parceiro   Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  papel         String // "RESPONSAVEL_LEGAL" | "REPRESENTANTE"
  tipoDocumento String? // "PF" | "PJ"
  documento     String?
  cargo         String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  @@unique([pessoaId, parceiroId, papel])
  @@index([parceiroId])
  @@index([pessoaId])
}

