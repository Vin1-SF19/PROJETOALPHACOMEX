// ─── Alpha BPM (2026-08-03) ───────────────────────────────────────────────────
// Sistema de BPM/gestão de processos. Empresa = `clientes`, Pessoa = `socios`,
// Setor = `Setor` (já existentes, reaproveitados — D-049). Card é a unidade central:
// 1 card = 1 execução de processo/demanda, sempre vinculado a uma empresa (D-021).
// Etapas/campos/SLA são metadados configuráveis via UI por pipeline (D-013), não enum fixo.

model BpmPipeline {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setores            BpmPipelineSetor[]
  etapas             BpmEtapa[]
  campos             BpmCampo[]
  cards              BpmCard[]
  configAuditoria    BpmPipelineConfigAuditoria[]
  checklistPerguntas BpmChecklistFollowUpPergunta[]

  @@index([ativo])
}

model BpmPipelineSetor {
  id         String @id @default(cuid())
  pipelineId String
  setorId    Int

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  setor    Setor       @relation(fields: [setorId], references: [id])

  @@unique([pipelineId, setorId])
  @@index([setorId])
}

model BpmEtapa {
  id         String  @id @default(cuid())
  pipelineId String
  nome       String
  ordem      Int     @default(0)
  slaDias    Int?
  script     String? // roteiro de texto exibido na aba "Script" da coluna Presente — só leitura por enquanto
  ativo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  campos   BpmCampo[]
  cards    BpmCard[]

  transicoesOrigem   BpmEtapaTransicaoPermitida[] @relation("TransicaoOrigem")
  transicoesDestino  BpmEtapaTransicaoPermitida[] @relation("TransicaoDestino")
  camposObrigatorios BpmCampoObrigatorioEtapa[]

  @@index([pipelineId])
  @@index([pipelineId, ordem])
}

model BpmCampo {
  id          String  @id @default(cuid())
  pipelineId  String
  etapaId     String?
  nome        String
  tipo        String // "texto" | "numero" | "data" | "selecao" | "booleano" (validado via Zod na action)
  opcoesJson  String? // opções quando tipo = "selecao"
  obrigatorio Boolean @default(false)
  ordem       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline            BpmPipeline                @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  etapa               BpmEtapa?                  @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  valores             BpmCardCampoValor[]
  obrigatorioEmEtapas BpmCampoObrigatorioEtapa[]

  @@index([pipelineId])
  @@index([etapaId])
}

model BpmCard {
  id            String  @id @default(cuid())
  empresaId     Int
  pipelineId    String
  etapaId       String
  responsavelId Int
  servico       String?
  status        String  @default("ATIVO") // "ATIVO" | "CONCLUIDO" | "CANCELADO"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidoEm DateTime?

  // Pipeline "Revisão de Radar" — automações e regras por etapa (2026-08-10, ver
  // .bibble/memory/plano-novos-leads-bpm.md). Todas nullable — nenhum card legado precisa
  // ser retroativamente preenchido; automações tratam ausência como "ainda não se aplica".
  primeiraVisualizacaoEm        DateTime? // primeiro acesso ao card, por qualquer usuário — indicador "nunca acessado" some após preenchido
  proximoContatoEm              DateTime? // interrompe a automação de 8 dias (cobrança de follow-up); também validado como obrigatório na ENTRADA de "Em Tratativa"/"Sem Viabilidade"
  // Standby - Follow Up: estado independente de proximoContatoEm.
  // `ultimo` limita a automação a uma tarefa por ciclo de 7 dias; `interrompido`
  // é NoLoss: pedido do lead para não receber mais follow-up e nunca é retomado automaticamente.
  standbyFollowUpUltimoEm       DateTime?
  standbyFollowUpInterrompidoEm DateTime?
  dataReuniao                   DateTime? // data+hora combinadas da reunião (Coluna "Agendar Reunião"), timezone America/Sao_Paulo — mesmo contrato da Agenda Alpha
  googleEventId                 String? // id do evento no Google Calendar, criado via botão "Agendar pelo Google Meet" — permite reagendar/atualizar o mesmo evento depois
  googleCalendarId              String? // GoogleCalendarSelecionado.googleCalendarId usado ao criar a reunião — necessário para reagendar via atualizarEventoParcialNoCalendario (achado na Fase D)
  googleMeetLink                String? // cache do hangoutLink retornado pela API, evita nova chamada só para exibir o link
  statusPosFechamento           String? // "AGUARDANDO_CONTRATO"|"CONTRATO_A_ENVIAR"|"CONTRATO_ENVIADO"|"PAGAMENTO_CONFIRMADO"|"CONTRATO_ASSINADO" — só relevante na etapa "Fechado"
  transcricaoReuniao            String? // texto livre — fallback manual da transcrição enquanto a integração automática com a Google Meet API não é decidida/implementada (Fase H, bloqueada)

  empresa     Cliente     @relation(fields: [empresaId], references: [id])
  pipeline    BpmPipeline @relation(fields: [pipelineId], references: [id])
  etapa       BpmEtapa    @relation(fields: [etapaId], references: [id])
  responsavel usuarios    @relation("BpmCardResponsavel", fields: [responsavelId], references: [id])

  campoValores       BpmCardCampoValor[]
  membros            BpmCardMembro[]
  tarefas            BpmTarefa[]
  historico          BpmCardHistorico[]
  anexos             BpmCardAnexo[]
  interacoes         BpmInteracaoCard[]
  checklistsFollowUp BpmChecklistFollowUp[]

  vinculosOrigem  BpmCardVinculo[] @relation("CardOrigem")
  vinculosDestino BpmCardVinculo[] @relation("CardDestino")

  nolossLeadOrigem NolossLead[]

  // CRM de Canais e Parcerias (Fase 04) — indicação de parceiro que originou este card, quando
  // aplicável. Puramente aditivo: nenhuma coluna nova em `BpmCard` (a FK vive em `Indicacao`).
  indicacaoOrigem Indicacao?

  @@index([empresaId])
  @@index([pipelineId])
  @@index([etapaId])
  @@index([responsavelId])
  @@index([status])
}

model BpmCardCampoValor {
  id      String  @id @default(cuid())
  cardId  String
  campoId String
  valor   String?

  card  BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  campo BpmCampo @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([cardId, campoId])
  @@index([campoId])
}

model BpmCardMembro {
  id        String   @id @default(cuid())
  cardId    String
  userId    Int
  role      String // "RESPONSAVEL" | "ADMINISTRADOR" | "PARTICIPANTE"
  createdAt DateTime @default(now())

  card    BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  usuario usuarios @relation(fields: [userId], references: [id])

  @@unique([cardId, userId])
  @@index([userId])
}

model BpmCardVinculo {
  id            String   @id @default(cuid())
  cardOrigemId  String
  cardDestinoId String
  createdAt     DateTime @default(now())

  cardOrigem  BpmCard @relation("CardOrigem", fields: [cardOrigemId], references: [id], onDelete: Cascade)
  cardDestino BpmCard @relation("CardDestino", fields: [cardDestinoId], references: [id], onDelete: Cascade)

  @@unique([cardOrigemId, cardDestinoId])
  @@index([cardDestinoId])
}

model BpmTarefa {
  id                String    @id @default(cuid())
  cardId            String
  titulo            String
  descricao         String?
  responsavelId     Int?
  prazo             DateTime?
  tipo              String    @default("TAREFA") // CHECKLIST | LIGACAO | WHATSAPP | EMAIL | TAREFA | LEMBRETE_RAPIDO
  alertaEm          DateTime?
  alertaDisparadoEm DateTime?
  prioridade        String    @default("NORMAL") // "BAIXA" | "NORMAL" | "ALTA"
  status            String    @default("PENDENTE") // "PENDENTE" | "CONCLUIDA"
  checklistJson     String?
  presetId          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidaEm DateTime?

  card        BpmCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  responsavel usuarios?        @relation(fields: [responsavelId], references: [id])
  preset      BpmTarefaPreset? @relation(fields: [presetId], references: [id])

  @@index([cardId])
  @@index([responsavelId])
  @@index([status])
  @@index([status, alertaEm])
}

model BpmTarefaPreset {
  id           String  @id @default(cuid())
  pipelineId   String?
  nome         String
  descricao    String?
  tipoGeracao  String  @default("UNICA") // "UNICA" | "MULTIPLA" | "FLUXO" (configurável via UI — D-026)
  templateJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarefas BpmTarefa[]

  @@index([pipelineId])
}

model BpmCardHistorico {
  id                String   @id @default(cuid())
  cardId            String
  acao              String
  valorAnteriorJson String?
  valorNovoJson     String?
  usuarioId         Int?
  automacaoOrigem   String?
  createdAt         DateTime @default(now())

  card    BpmCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  usuario usuarios? @relation(fields: [usuarioId], references: [id])

  @@index([cardId])
  @@index([createdAt])
}

model BpmPipelineConfigAuditoria {
  id                String   @id @default(cuid())
  pipelineId        String
  adminId           Int
  campoAlterado     String
  valorAnteriorJson String?
  valorNovoJson     String?
  createdAt         DateTime @default(now())

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  admin    usuarios    @relation(fields: [adminId], references: [id])

  @@index([pipelineId])
  @@index([createdAt])
}

model BpmCardAnexo {
  id           String   @id @default(cuid())
  cardId       String
  url          String
  nome         String
  tipo         String?
  tamanho      Int?
  enviadoPorId Int
  createdAt    DateTime @default(now())

  card       BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  enviadoPor usuarios @relation(fields: [enviadoPorId], references: [id])

  @@unique([cardId, url]) // recibo de upload é idempotente mesmo sob requisições concorrentes
  @@index([cardId])
}

model BpmInteracaoCard {
  id              String    @id @default(cuid())
  cardId          String
  tipo            String    @default("LIGACAO") // string livre p/ extensão futura sem migration (hoje só "LIGACAO")
  agendadoEm      DateTime?
  agendaLink      String?
  observacoes     String?
  resumo          String?
  registradoPorId Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  card          BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  registradoPor usuarios @relation(fields: [registradoPorId], references: [id])

  @@index([cardId])
  @@index([createdAt])
}

// Pipeline "Revisão de Radar" — máquina de estado de transições permitidas entre etapas
// (2026-08-10, ver .bibble/memory/plano-novos-leads-bpm.md). Etapa SEM nenhuma linha aqui
// como origem continua permitindo qualquer destino — fallback preserva o comportamento
// atual dos pipelines "Financeiro"/"Radar", que nunca pediram essa restrição.
model BpmEtapaTransicaoPermitida {
  id             String   @id @default(cuid())
  etapaOrigemId  String
  etapaDestinoId String
  etapaOrigem    BpmEtapa @relation("TransicaoOrigem", fields: [etapaOrigemId], references: [id], onDelete: Cascade)
  etapaDestino   BpmEtapa @relation("TransicaoDestino", fields: [etapaDestinoId], references: [id], onDelete: Cascade)

  @@unique([etapaOrigemId, etapaDestinoId])
  @@index([etapaOrigemId])
}

// Lead recebido do NoLoss (formulário do site → audience "Leads" → webhook da campanha)
// como staging antes de virar Cliente/BpmCard reais. Exibido como card VIRTUAL na 1ª
// coluna ("Novos leads") do pipeline "Revisão de Radar" enquanto status = "pending".
// Promovido (cria Cliente + BpmCard em transação) só quando um usuário arrasta o card
// para outra etapa — nunca automaticamente.
model NolossLead {
  id                 String    @id @default(cuid())
  nolossContactId    String    @unique
  nolossSubmissionId String?
  nome               String?
  email              String?
  telefone           String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  status             String    @default("pending") // pending | promoted | dismissed
  promotedClienteId  Int?
  promotedCardId     String?
  promotedAt         DateTime?
  promotedByUserId   Int?
  receivedAt         DateTime  @default(now())

  promotedCliente Cliente?  @relation(fields: [promotedClienteId], references: [id])
  promotedCard    BpmCard?  @relation(fields: [promotedCardId], references: [id])
  promotedByUser  usuarios? @relation(fields: [promotedByUserId], references: [id])

  @@index([status])
}

// Permite que um BpmCampo de nível pipeline (etapaId: null) seja obrigatório só em etapas
// específicas, sem duplicar o campo por etapa (ex: "Valor acordado no contrato" é o mesmo
// campo em Reunião Agendada/Em Tratativa/Fechado, mas só passa a ser obrigatório nelas).
model BpmCampoObrigatorioEtapa {
  id      String   @id @default(cuid())
  campoId String
  etapaId String
  campo   BpmCampo @relation(fields: [campoId], references: [id], onDelete: Cascade)
  etapa   BpmEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@unique([campoId, etapaId])
  @@index([etapaId])
}

// Checklist de follow-up obrigatório da etapa "Em Tratativa" — a lógica de UI que trava o
// fechamento do card até o checklist estar completo é implementada em fase separada (Fase G),
// e depende do catálogo de perguntas ainda não definido pelo usuário; o schema nasce pronto
// para receber esse catálogo quando existir.
model BpmChecklistFollowUp {
  id            String   @id @default(cuid())
  cardId        String
  card          BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  perguntasJson String // snapshot das perguntas NO MOMENTO do follow-up — perguntas podem mudar no catálogo depois sem afetar registros passados
  respostasJson String
  completo      Boolean  @default(false)
  criadoPorId   Int
  criadoEm      DateTime @default(now())

  usuario usuarios @relation(fields: [criadoPorId], references: [id])

  @@index([cardId])
}

model BpmChecklistFollowUpPergunta {
  id          String  @id @default(cuid())
  pipelineId  String
  pergunta    String
  tipo        String // "texto" | "selecao" | "booleano" — mesmo catálogo de BpmCampo
  opcoesJson  String?
  obrigatoria Boolean @default(true)
  ordem       Int     @default(0)
  ativo       Boolean @default(true)

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

// `model PessoaEmpresaVinculo` removido em 2026-08-14 (Fase 3.6 do Cliente Master) —
// dependia de `socios`/`clientes` (ambos removidos), tabela física vazia (0 linhas)
// desde antes desta fase, nunca chegou a ser usada de fato.

// ═══════════════════════════════════════════════════════════════════════════
// Alpha SEO — schema integrado ao runtime após gate Vault aplicado e validado
// ═══════════════════════════════════════════════════════════════════════════

/// Projeto SEO é a fronteira multi-tenant do módulo. `ownerId` é a fonte
/// canônica de ownership; a linha OWNER em members é uma projeção operacional
/// que deve ser mantida na mesma transação pela camada de serviço.
model AlphaSeoProject {
  id               String    @id @default(cuid())
  ownerId          Int
  name             String
  domain           String?
  normalizedDomain String?
  locationCode     Int       @default(2840)
  locationName     String?
  languageCode     String    @default("pt")
  market           String    @default("BR")
  status           String    @default("ACTIVE") // ACTIVE | ARCHIVED
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner                usuarios                        @relation("AlphaSeoProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members              AlphaSeoProjectMember[]
  invitations          AlphaSeoProjectInvitation[]
  onboardingSelections AlphaSeoUserOnboarding[]
  activation           AlphaSeoProjectActivation?
  keywordResearchRuns  AlphaSeoKeywordResearchRun[]
  savedKeywords        AlphaSeoSavedKeyword[]
  savedKeywordTags     AlphaSeoSavedKeywordTag[]
  keywordMetrics       AlphaSeoKeywordMetric[]
  rankConfigs          AlphaSeoRankConfig[]
  audits               AlphaSeoSiteAudit[]
  googleOAuthNonces    AlphaSeoGoogleOAuthNonce[]
  gscConnection        AlphaSeoGscConnection?
  ga4Connection        AlphaSeoGa4Connection?
  contextSections      AlphaSeoProjectContextSection[]
  competitors          AlphaSeoProjectCompetitor[]
  keyPages             AlphaSeoProjectKeyPage[]
  researchLog          AlphaSeoProjectResearchLog[]
  samSessions          AlphaSeoSamSession[]
  backlinkSnapshots    AlphaSeoBacklinkSnapshot[]
  apiKeys              AlphaSeoApiKey[]
  mcpGrants            AlphaSeoMcpOAuthGrant[]
  jobs                 AlphaSeoJob[]
  costApprovals        AlphaSeoCostApproval[]
  exports              AlphaSeoExport[]
  aiVisibilityRuns     AlphaSeoAiVisibilityRun[]
  externalOperations   AlphaSeoExternalOperationRun[]
  providerCache        AlphaSeoProviderCache[]
  auditEvents          AlphaSeoAuditEvent[]

  @@index([ownerId, status, updatedAt])
  @@index([status, archivedAt, updatedAt])
  @@index([normalizedDomain])
}

model AlphaSeoProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    Int
  role      String // OWNER | EDITOR | VIEWER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    usuarios        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId, active, updatedAt])
  @@index([projectId, role, active])
}

model AlphaSeoProjectInvitation {
  id              String    @id @default(cuid())
  projectId       String
  email           String
  normalizedEmail String
  role            String // EDITOR | VIEWER
  status          String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  tokenHash       String    @unique
  inviterId       Int
  acceptedById    Int?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter    usuarios        @relation("AlphaSeoInvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  acceptedBy usuarios?       @relation("AlphaSeoInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, expiresAt])
  @@index([normalizedEmail, status, expiresAt])
}

model AlphaSeoUserOnboarding {
  userId              Int       @id
  activeProjectId     String?
  interestedFeatures  Json
  workFor             String?
  clientWebsiteCount  String?
  foundVia            String?
  mcpSetupIntent      String?
  completedAt         DateTime?
  gscNudgeDismissedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user          usuarios         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeProject AlphaSeoProject? @relation(fields: [activeProjectId], references: [id], onDelete: SetNull)

  @@index([activeProjectId])
}

model AlphaSeoUserActivation {
  userId               Int       @id
  firstMcpAuthorizedAt DateTime?
  firstMcpToolCallAt   DateTime?
  updatedAt            DateTime  @updatedAt

  user usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AlphaSeoProjectActivation {
  projectId               String    @id
  competitorStepClickedAt DateTime?
  mcpCardDismissedAt      DateTime?
  ga4CardDismissedAt      DateTime?
  updatedAt               DateTime  @updatedAt

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Histórico reproduzível de pesquisa. Seeds/request/result são snapshots
/// tipados na camada Zod; não duplicam SavedKeyword nem KeywordMetric.
model AlphaSeoKeywordResearchRun {
  id                 String    @id @default(cuid())
  projectId          String
  requestedById      Int
  mode               String // AUTO | RELATED | SUGGESTIONS | IDEAS
  locationCode       Int
  languageCode       String
  includeClickstream Boolean   @default(false)
  seeds              Json
  request            Json
  requestHash        String
  idempotencyKey     String    @unique
  status             String    @default("PENDING")
  result             Json?
  partialResult      Json?
  errorCode          String?
  estimatedUnits     Int       @default(0)
  estimatedMicrosUsd Int       @default(0)
  actualUnits        Int?
  actualMicrosUsd    Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  project     AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy usuarios        @relation("AlphaSeoKeywordResearchRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, requestHash, createdAt])
  @@index([status, createdAt])
}

model AlphaSeoSavedKeyword {
  id           String   @id @default(cuid())
  projectId    String
  keyword      String
  normalized   String
  locationCode Int      @default(2840)
  languageCode String   @default("pt")
  createdAt    DateTime @default(now())

  project        AlphaSeoProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagAssignments AlphaSeoSavedKeywordTagAssignment[]

  @@unique([projectId, normalized, locationCode, languageCode])
  @@index([projectId, createdAt])
}

model AlphaSeoSavedKeywordTag {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  normalizedName String
  color          String?
  createdAt      DateTime @default(now())

  project     AlphaSeoProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments AlphaSeoSavedKeywordTagAssignment[]

  @@unique([projectId, normalizedName])
  @@index([projectId, name])
}

model AlphaSeoSavedKeywordTagAssignment {
  savedKeywordId String
  tagId          String
  createdAt      DateTime @default(now())

  savedKeyword AlphaSeoSavedKeyword    @relation(fields: [savedKeywordId], references: [id], onDelete: Cascade)
  tag          AlphaSeoSavedKeywordTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedKeywordId, tagId])
  @@index([tagId])
}

model AlphaSeoKeywordMetric {
  id                String   @id @default(cuid())
  projectId         String
  keyword           String
  normalizedKeyword String
  locationCode      Int
  languageCode      String
  searchVolume      Int?
  cpcMicros         Int?
  competition       Float?
  keywordDifficulty Int?
  intent            String?
  monthlySearches   Json?
  fetchedAt         DateTime @default(now())

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, normalizedKeyword, locationCode, languageCode])
  @@index([projectId, normalizedKeyword, locationCode, languageCode, fetchedAt])
}

model AlphaSeoRankConfig {
  id               String    @id @default(cuid())
  projectId        String
  domain           String
  normalizedDomain String
  locationCode     Int       @default(2840)
  locationName     String?
  languageCode     String    @default("pt")
  devices          String    @default("BOTH") // BOTH | DESKTOP | MOBILE
  serpDepth        Int
  scheduleInterval String    @default("WEEKLY") // MANUAL | DAILY | WEEKLY | MONTHLY
  scheduleAnchorAt DateTime?
  isActive         Boolean   @default(true)
  lastCheckedAt    DateTime?
  nextCheckAt      DateTime?
  lastSkipReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project  AlphaSeoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywords AlphaSeoRankKeyword[]
  runs     AlphaSeoRankRun[]

  @@index([projectId, isActive, createdAt])
  @@index([isActive, nextCheckAt])
  @@index([projectId, normalizedDomain, locationCode, locationName])
}

model AlphaSeoRankKeyword {
  id                String    @id @default(cuid())
  configId          String
  keyword           String
  normalizedKeyword String
  searchVolume      Int?
  keywordDifficulty Int?
  cpcMicros         Int?
  metricsFetchedAt  DateTime?
  createdAt         DateTime  @default(now())

  config AlphaSeoRankConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, normalizedKeyword])
  @@index([configId, createdAt])
}

model AlphaSeoRankRun {
  id                 String    @id @default(cuid())
  configId           String
  requestedById      Int?
  trigger            String // MANUAL | SCHEDULED
  scheduledFor       DateTime?
  idempotencyKey     String    @unique
  status             String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  keywordsTotal      Int       @default(0)
  keywordsChecked    Int       @default(0)
  isSubsetRun        Boolean   @default(false)
  estimatedUnits     Int       @default(0)
  estimatedMicrosUsd Int       @default(0)
  actualUnits        Int?
  actualMicrosUsd    Int?
  errorCode          String?
  errorMessage       String?
  leaseOwner         String?
  leaseToken         Int       @default(0)
  leaseExpiresAt     DateTime?
  heartbeatAt        DateTime?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  config      AlphaSeoRankConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  requestedBy usuarios?              @relation("AlphaSeoRankRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  snapshots   AlphaSeoRankSnapshot[]

  @@index([configId, startedAt])
  @@index([status, leaseExpiresAt])
  @@index([scheduledFor, status])
}

/// Sem FK para RankKeyword de propósito: remover uma keyword do tracking não
/// pode apagar seu histórico de posição.
model AlphaSeoRankSnapshot {
  id                String   @id @default(cuid())
  runId             String
  trackingKeywordId String
  keyword           String
  device            String // DESKTOP | MOBILE
  position          Int?
  rankedUrl         String?
  serpFeatures      Json?
  checkedAt         DateTime @default(now())

  run AlphaSeoRankRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, trackingKeywordId, device])
  @@index([trackingKeywordId, device, checkedAt])
}

model AlphaSeoSiteAudit {
  id                  String    @id @default(cuid())
  projectId           String
  startedById         Int
  startUrl            String
  idempotencyKey      String    @unique
  status              String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  workflowInstanceId  String?
  config              Json
  pagesCrawled        Int       @default(0)
  pagesTotal          Int       @default(0)
  lighthouseTotal     Int       @default(0)
  lighthouseCompleted Int       @default(0)
  lighthouseFailed    Int       @default(0)
  currentPhase        String    @default("DISCOVERY")
  errorCode           String?
  errorDetail         String?
  failedPhase         String?
  leaseOwner          String?
  leaseToken          Int       @default(0)
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  project    AlphaSeoProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy  usuarios                  @relation("AlphaSeoSiteAuditStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  pages      AlphaSeoAuditPage[]
  issues     AlphaSeoAuditIssue[]
  lighthouse AlphaSeoAuditLighthouse[]

  @@index([projectId, createdAt])
  @@index([startedById, createdAt])
  @@index([status, heartbeatAt])
}

model AlphaSeoAuditPage {
  id                 String  @id @default(cuid())
  auditId            String
  url                String
  statusCode         Int?
  redirectUrl        String?
  title              String?
  metaDescription    String?
  canonicalUrl       String?
  robotsMeta         String?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  h1Count            Int     @default(0)
  h2Count            Int     @default(0)
  h3Count            Int     @default(0)
  h4Count            Int     @default(0)
  h5Count            Int     @default(0)
  h6Count            Int     @default(0)
  headingOrder       Json?
  wordCount          Int     @default(0)
  imagesTotal        Int     @default(0)
  imagesMissingAlt   Int     @default(0)
  images             Json?
  internalLinkCount  Int     @default(0)
  externalLinkCount  Int     @default(0)
  hasStructuredData  Boolean @default(false)
  hreflangTags       Json?
  isIndexable        Boolean @default(true)
  xRobotsTag         String?
  headerCanonicalUrl String?
  crawlDepth         Int?
  inSitemap          Boolean @default(false)
  contentHash        String?
  fetchClass         String  @default("OK") // OK | BLOCKED | ERROR
  responseTimeMs     Int?

  audit      AlphaSeoSiteAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues     AlphaSeoAuditIssue[]
  lighthouse AlphaSeoAuditLighthouse[]

  @@unique([auditId, url])
  @@index([auditId, statusCode])
}

model AlphaSeoAuditIssue {
  id        String  @id @default(cuid())
  auditId   String
  pageId    String?
  pageUrl   String
  issueType String
  severity  String  @default("INFO") // CRITICAL | WARNING | INFO
  details   Json?

  audit AlphaSeoSiteAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page  AlphaSeoAuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([auditId, issueType])
  @@index([pageId])
  @@index([auditId, severity])
}

model AlphaSeoAuditLighthouse {
  id                 String  @id @default(cuid())
  auditId            String
  pageId             String
  strategy           String // MOBILE | DESKTOP
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  lcpMs              Float?
  cls                Float?
  inpMs              Float?
  ttfbMs             Float?
  errorMessage       String?
  storageKey         String?
  payloadSizeBytes   Int?

  audit AlphaSeoSiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page  AlphaSeoAuditPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, strategy])
  @@index([auditId])
}

/// State + PKCE do Google. O verifier precisa ser recuperado no callback, por
/// isso é ciphertext autenticado e versionado — nunca hash-only nem plaintext.
model AlphaSeoGoogleOAuthNonce {
  id                     String    @id @default(cuid())
  userId                 Int
  projectId              String
  product                String // GSC | GA4
  stateHash              String    @unique
  codeVerifierCiphertext String
  tokenKeyVersion        Int       @default(1)
  redirectUriHash        String
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime  @default(now())

  user    usuarios        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, product, expiresAt])
  @@index([projectId, product, expiresAt])
}

/// Grant por conta Google/usuário. Tokens são sempre ciphertext autenticado;
/// as conexões de GSC e GA4 abaixo só selecionam a property do projeto.
model AlphaSeoGoogleOAuthGrant {
  id                     String    @id @default(cuid())
  userId                 Int
  product                String // GSC | GA4
  accountId              String
  accountEmail           String?
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  idTokenCiphertext      String?
  scopes                 Json
  tokenKeyVersion        Int       @default(1)
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user           usuarios                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gscConnections AlphaSeoGscConnection[]
  ga4Connections AlphaSeoGa4Connection[]

  @@unique([userId, product, accountId])
  @@index([product, accessTokenExpiresAt])
  @@index([userId, revokedAt])
}

model AlphaSeoGscConnection {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  grantId               String
  connectedById         Int
  siteUrl               String
  connectedAccountEmail String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project     AlphaSeoProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant       AlphaSeoGoogleOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  connectedBy usuarios                 @relation("AlphaSeoGscConnectedBy", fields: [connectedById], references: [id], onDelete: Restrict)

  @@index([grantId])
  @@index([connectedById, grantId])
}

model AlphaSeoGa4Connection {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  grantId               String
  connectedById         Int
  propertyId            String
  propertyDisplayName   String
  propertyTimeZone      String
  propertyCurrencyCode  String
  connectedAccountEmail String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project     AlphaSeoProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grant       AlphaSeoGoogleOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  connectedBy usuarios                 @relation("AlphaSeoGa4ConnectedBy", fields: [connectedById], references: [id], onDelete: Restrict)

  @@index([grantId])
  @@index([connectedById, grantId])
}

model AlphaSeoProjectContextSection {
  projectId       String
  key             String
  title           String?
  content         String
  updatedByKind   String // USER | SAM | MCP
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt

  project       AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedByUser usuarios?       @relation("AlphaSeoContextSectionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@id([projectId, key])
  @@index([updatedByUserId, updatedAt])
}

model AlphaSeoProjectCompetitor {
  id               String   @id @default(cuid())
  projectId        String
  domain           String
  normalizedDomain String
  name             String?
  notes            String?
  updatedByKind    String // USER | SAM | MCP
  updatedByUserId  Int?
  updatedAt        DateTime @updatedAt

  project       AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedByUser usuarios?       @relation("AlphaSeoCompetitorUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, normalizedDomain])
  @@index([updatedByUserId, updatedAt])
}

model AlphaSeoProjectKeyPage {
  id              String   @id @default(cuid())
  projectId       String
  url             String
  normalizedUrl   String
  role            String // HUB | SPOKE | MONEY | OTHER
  topic           String?
  notes           String?
  updatedByKind   String // USER | SAM | MCP
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt

  project       AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedByUser usuarios?       @relation("AlphaSeoKeyPageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, normalizedUrl])
  @@index([updatedByUserId, updatedAt])
}

model AlphaSeoProjectResearchLog {
  id              String   @id @default(cuid())
  projectId       String
  entryDate       String
  summary         String
  createdByKind   String // USER | SAM | MCP
  createdByUserId Int?
  createdAt       DateTime @default(now())

  project       AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser usuarios?       @relation("AlphaSeoResearchLogCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, entryDate, createdAt])
  @@index([createdByUserId, createdAt])
}

model AlphaSeoSamSession {
  id          String    @id @default(cuid())
  projectId   String
  userId      Int
  title       String    @default("Nova conversa")
  status      String    @default("ACTIVE") // ACTIVE | CANCELLED | ARCHIVED
  cancelledAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  AlphaSeoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     usuarios             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AlphaSeoSamMessage[]

  @@index([projectId, updatedAt])
  @@index([userId, status, updatedAt])
}

model AlphaSeoSamMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // USER | ASSISTANT | TOOL | SYSTEM
  content   String
  toolCall  Json?
  createdAt DateTime @default(now())

  session AlphaSeoSamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model AlphaSeoBacklinkSnapshot {
  id                   String   @id @default(cuid())
  projectId            String
  domain               String
  rank                 Int?
  backlinks            Int?
  referringDomains     Int?
  brokenBacklinks      Int?
  newBacklinks         Int?
  lostBacklinks        Int?
  newReferringDomains  Int?
  lostReferringDomains Int?
  capturedAt           DateTime @default(now())

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt])
}

/// API key do MCP/automação. Somente hash e prefixo são persistidos.
model AlphaSeoApiKey {
  id                String    @id @default(cuid())
  projectId         String
  createdById       Int
  label             String
  keyHash           String    @unique
  prefix            String
  scopes            Json
  enabled           Boolean   @default(true)
  rateLimitWindowMs Int       @default(60000)
  rateLimitMax      Int       @default(120)
  requestCount      Int       @default(0)
  lastRequestAt     DateTime?
  lastUsedAt        DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project   AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy usuarios        @relation("AlphaSeoApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, revokedAt])
  @@index([prefix])
}

/// Registro dinâmico de OAuth client. Segredos confidenciais ficam hash-only;
/// redirect URIs e metadados públicos são arrays/objetos Json validados.
model AlphaSeoMcpOAuthClient {
  id                      String    @id @default(cuid())
  clientId                String    @unique
  clientSecretHash        String?
  clientName              String
  redirectUris            Json
  grantTypes              Json
  responseTypes           Json
  tokenEndpointAuthMethod String
  scopes                  Json
  createdById             Int?
  revokedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  createdBy usuarios?               @relation("AlphaSeoMcpClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  grants    AlphaSeoMcpOAuthGrant[]

  @@index([createdById, revokedAt])
}

model AlphaSeoMcpOAuthGrant {
  id            String    @id @default(cuid())
  oauthClientId String
  userId        Int
  projectId     String
  scopes        Json
  resource      String?
  status        String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  consentedAt   DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client             AlphaSeoMcpOAuthClient         @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  user               usuarios                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            AlphaSeoProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorizationCodes AlphaSeoMcpAuthorizationCode[]
  accessTokens       AlphaSeoMcpAccessToken[]
  refreshTokens      AlphaSeoMcpRefreshToken[]

  @@index([oauthClientId, userId, projectId, status])
  @@index([userId, status, expiresAt])
  @@index([projectId, status])
}

model AlphaSeoMcpAuthorizationCode {
  id                  String    @id @default(cuid())
  grantId             String
  codeHash            String    @unique
  redirectUriHash     String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  nonceHash           String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  grant AlphaSeoMcpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, expiresAt, consumedAt])
}

model AlphaSeoMcpAccessToken {
  id         String    @id @default(cuid())
  grantId    String
  tokenHash  String    @unique
  scopes     Json
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  grant AlphaSeoMcpOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, expiresAt, revokedAt])
}

model AlphaSeoMcpRefreshToken {
  id            String    @id @default(cuid())
  grantId       String
  tokenHash     String    @unique
  tokenFamilyId String
  parentTokenId String?
  scopes        Json
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  grant       AlphaSeoMcpOAuthGrant     @relation(fields: [grantId], references: [id], onDelete: Cascade)
  parentToken AlphaSeoMcpRefreshToken?  @relation("AlphaSeoMcpRefreshRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  rotations   AlphaSeoMcpRefreshToken[] @relation("AlphaSeoMcpRefreshRotation")

  @@index([grantId, expiresAt, revokedAt])
  @@index([tokenFamilyId, createdAt])
  @@index([parentTokenId])
}

model AlphaSeoJob {
  id               String    @id @default(cuid())
  projectId        String?
  type             String
  status           String    @default("PENDING") // PENDING | PROCESSING | RETRY | SUCCEEDED | DEAD_LETTER | CANCELLED
  idempotencyKey   String    @unique
  payload          Json
  result           Json?
  priority         Int       @default(100)
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  availableAt      DateTime  @default(now())
  claimedBy        String?
  claimedAt        DateTime?
  claimExpiresAt   DateTime?
  claimToken       Int       @default(0)
  heartbeatAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?
  deadLetteredAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project AlphaSeoProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, priority, createdAt])
  @@index([status, claimExpiresAt])
  @@index([projectId, type, status])
}

model AlphaSeoCostApproval {
  id                 String   @id @default(cuid())
  projectId          String
  userId             Int
  operation          String
  requestHash        String
  estimatedUnits     Int      @default(0)
  estimatedMicrosUsd Int      @default(0)
  approvedAt         DateTime @default(now())
  expiresAt          DateTime

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    usuarios        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId, operation, requestHash])
  @@index([expiresAt])
}

model AlphaSeoExport {
  id          String    @id @default(cuid())
  projectId   String
  createdById Int
  kind        String
  format      String // CSV | GOOGLE_SHEETS
  filters     Json
  columns     Json
  status      String    @default("PENDING")
  storageRef  String?
  errorCode   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project   AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy usuarios        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([createdById, createdAt])
}

model AlphaSeoAiVisibilityRun {
  id                 String    @id @default(cuid())
  projectId          String
  requestedById      Int
  kind               String // BRAND_LOOKUP | PROMPT_EXPLORER
  query              String
  requestHash        String
  idempotencyKey     String    @unique
  status             String    @default("PENDING")
  estimatedMicrosUsd Int       @default(0)
  actualMicrosUsd    Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  project         AlphaSeoProject                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy     usuarios                             @relation("AlphaSeoAiRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  providerResults AlphaSeoAiVisibilityProviderResult[]

  @@index([projectId, kind, createdAt])
  @@index([projectId, requestHash, createdAt])
}

model AlphaSeoAiVisibilityProviderResult {
  id              String   @id @default(cuid())
  runId           String
  provider        String // CHATGPT | CLAUDE | GEMINI | PERPLEXITY
  status          String
  result          Json?
  errorCode       String?
  durationMs      Int?
  actualMicrosUsd Int?
  createdAt       DateTime @default(now())

  run AlphaSeoAiVisibilityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, provider])
  @@index([provider, createdAt])
}

/// Histórico comum para Domain Overview, Backlinks detalhado, SERP, GSC e os
/// relatórios GA4. O payload externo é um snapshot canônico da execução e não
/// duplica entidades relacionais do projeto.
model AlphaSeoExternalOperationRun {
  id                 String    @id @default(cuid())
  projectId          String
  requestedById      Int
  provider           String
  operation          String
  target             String?
  request            Json
  requestHash        String
  idempotencyKey     String    @unique
  status             String    @default("PENDING")
  result             Json?
  partialResult      Json?
  estimatedUnits     Int       @default(0)
  estimatedMicrosUsd Int       @default(0)
  actualUnits        Int?
  actualMicrosUsd    Int?
  errorCode          String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  project     AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy usuarios        @relation("AlphaSeoExternalOperationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([projectId, operation, createdAt])
  @@index([projectId, requestHash, createdAt])
  @@index([provider, status, createdAt])
}

model AlphaSeoProviderCache {
  id           String   @id @default(cuid())
  projectId    String
  provider     String
  operation    String
  cacheKeyHash String
  payload      Json
  sourceRunId  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project AlphaSeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, operation, cacheKeyHash])
  @@index([expiresAt])
}

model AlphaSeoAuditEvent {
  id         String   @id @default(cuid())
  projectId  String?
  userId     Int?
  action     String
  entityType String
  entityId   String?
  requestId  String
  metadata   Json?
  createdAt  DateTime @default(now())

  project AlphaSeoProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    usuarios?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

/// Módulo Gerador de Documentos (RM-2026-999766). Template com variáveis
/// dinâmicas + cláusulas separadas — cada cláusula é uma unidade editável
/// independente, tanto no template quanto no documento gerado a partir dele.
model DocumentoTemplate {
  id                String   @id @default(cuid())
  titulo            String
  descricao         String?
  categoria         String? // "contrato" | "proposta" | "aviso" | "outro" — texto livre, sem enum real
  variaveisJson     Json // array de { nome, label, tipo, obrigatorio, placeholder }
  status            String   @default("ATIVO") // "ATIVO" | "ARQUIVADO"
  arquivoOrigemUrl  String? // Vercel Blob do documento original, quando o template nasce de upload (RM-2026-93645F)
  arquivoOrigemNome String? // nome do arquivo original enviado pelo usuário
  criadoPorId       Int
  criadoPor         usuarios @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  clausulas  DocumentoClasula[]
  documentos DocumentoGerado[]

  @@index([criadoPorId, criadoEm])
  @@index([status, criadoEm])
}

/// Cláusula de um template — unidade independente e ordenável dentro do
/// documento, com placeholders {{variavel}} substituídos na geração.
model DocumentoClasula {
  id           String   @id @default(cuid())
  templateId   String
  ordem        Int
  titulo       String
  conteudo     String // texto com placeholders {{variavel}}
  tipo         String   @default("TEXTO") // "TEXTO" | "TABELA" | "ASSINATURA"
  editavel     Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  template DocumentoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, ordem])
  @@index([templateId])
}

/// Instância gerada de um template com variáveis preenchidas. `tokenAcesso`
/// identifica o documento na URL de conferência, mas NUNCA é autorização por
/// si só — a rota exige auth() + ownership antes de renderizar (decisão
/// 2026-08-28, ver docs/stories/story-gerador-documentos-fase1-blueprint.md
/// seção 9 item 5 — objetivo original exige link não-público).
model DocumentoGerado {
  id                  String    @id @default(cuid())
  templateId          String
  titulo              String
  variaveisJson       Json // valores preenchidos nas variáveis do template
  status              String    @default("RASCUNHO") // "RASCUNHO" | "CONFERENCIA" | "FINALIZADO" | "ARQUIVADO"
  tokenAcesso         String    @unique
  criadoPorId         Int
  criadoPor           usuarios  @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt
  finalizadoEm        DateTime?
  // Contratante/contratada + PDF final (evolução pós-RM-2026-93645F): todos
  // opcionais/aditivos — documentos gerados antes desta mudança ficam null.
  clienteId           Int? // contratante — FK para o Cliente master (empresa da carteira Alpha Comex)
  cliente             Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresaContratadaId String? // contratada — FK para EmpresaContratada (cadastro de qualificação)
  empresaContratada   EmpresaContratada? @relation(fields: [empresaContratadaId], references: [id], onDelete: SetNull)
  pdfUrl              String? // URL do PDF final gerado (Vercel Blob), disponível para download

  template  DocumentoTemplate        @relation(fields: [templateId], references: [id])
  clausulas DocumentoClasulaGerada[]

  @@index([criadoPorId, criadoEm])
  @@index([status, criadoEm])
  @@index([templateId])
  @@index([tokenAcesso])
  @@index([clienteId])
  @@index([empresaContratadaId])
}

/// Qualificação de empresa CONTRATADA em documentos gerados pelo módulo —
/// cadastro global do módulo (não por usuário), populável via consulta à
/// Receita Federal (dados cadastrais) + preenchimento manual (representante
/// legal, que a Receita não retorna formalmente).
model EmpresaContratada {
  id                      String   @id @default(cuid())
  razaoSocial             String
  nomeFantasia            String?
  cnpj                    String   @unique
  logradouro              String?
  numero                  String?
  bairro                  String?
  municipio               String?
  uf                      String?
  cep                     String?
  naturezaJuridica        String?
  representanteLegalNome  String?
  representanteLegalCpf   String?
  representanteLegalCargo String?
  status                  String   @default("ATIVO") // "ATIVO" | "ARQUIVADO"
  criadoPorId             Int
  criadoPor               usuarios @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  documentosGerados DocumentoGerado[]

  @@index([status, criadoEm])
}

/// Cláusula de um documento já gerado — mantém o texto original do template
/// (para diff/auditoria) separado do texto final, que pode ter sido
/// reescrito pela IA padrão do painel (Onyx) mediante instrução do usuário.
model DocumentoClasulaGerada {
  id               String   @id @default(cuid())
  documentoId      String
  ordem            Int
  titulo           String
  conteudo         String // texto final (variáveis substituídas, possivelmente reescrito por IA)
  conteudoOriginal String // texto do template no momento da geração, para diff
  reescritoPorIA   Boolean  @default(false)
  instrucaoIA      String? // instrução do usuário usada na última reescrita (auditoria)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  documento DocumentoGerado @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, ordem])
  @@index([documentoId])
}
