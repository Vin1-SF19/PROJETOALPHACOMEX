  alphaSeoExportsCriados               AlphaSeoExport[]
  alphaSeoAiRunsSolicitados            AlphaSeoAiVisibilityRun[]       @relation("AlphaSeoAiRunRequestedBy")
  alphaSeoOperacoesExternasSolicitadas AlphaSeoExternalOperationRun[]  @relation("AlphaSeoExternalOperationRequestedBy")
