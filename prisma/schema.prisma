// ═══════════════════════════════════════════════════════════════════════════
// Gestão de Comissões e Prêmios (módulo novo, 2026-07-28)
// Schema aplicado no Turso via script pontual (Vault, Fase 02 da fila prompt-phases).
// Dinheiro sempre em centavos (Int). FK de usuário sempre Int (usuarios.id).
// ═══════════════════════════════════════════════════════════════════════════

model CommissionEvent {
  id        String @id @default(cuid())
  eventType String // CONTRACTING|PROCESS_STARTED|PROCESS_SUCCESS|FIRST_ATTEMPT_SUCCESS|AUXILIARY_PARTICIPATION|MANUAL_EVENT|CANCELLATION|REVERSAL

  // Fase 3.7 do Cliente Master (2026-08-14): campo antigo "clienteId" continha na verdade
  // ClienteServico.id (correlação por serviço contratado, não por empresa) — renomeado para
  // clienteServicoId com FK real, preservando o valor e o comportamento de correlação
  // existentes. clienteId agora aponta de fato para Cliente (derivado via ClienteServico.clienteId),
  // adicional e nullable (evento manual nunca preenche nenhum dos dois).
  clienteServicoId Int?
  clienteServico   ClienteServico? @relation(fields: [clienteServicoId], references: [id])
  clienteId        Int?
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])

  contratoComercialId String?
  contratoComercial   ContratoComercial? @relation(fields: [contratoComercialId], references: [id])
  businessProcessId   String?
  businessProcess     BusinessProcess?   @relation(fields: [businessProcessId], references: [id])

  cnpj         String // snapshot intencional (auditoria financeira) — nunca substituído por FK, ver plano-cliente-master.md
  razaoSocial  String // snapshot intencional
  nomeFantasia String? // snapshot intencional
  servico      String // snapshot intencional
  eventDate    DateTime

  grossContractAmountCents Int
  partnerSpreadCents       Int     @default(0)
  thirdPartyCostsCents     Int     @default(0)
  discountAmountCents      Int     @default(0)
  netContractAmountCents   Int
  commissionableBaseCents  Int?
  formaPagamento           String?

  // Closer/analista responsável — FK real (preferível, permite navegar até o usuário) quando
  // resolvido via ContratoComercial.usuarioId/BusinessProcess.analistaResponsavelId; nome
  // manual (string, sem FK) quando só existe como texto livre ou foi preenchido à mão porque
  // nenhuma fonte tinha o dado. Nunca inventar um FK a partir de string sem garantia de match.
  closerUsuarioId               Int?
  closerNomeManual              String?
  analistaResponsavelUsuarioId  Int?
  analistaResponsavelNomeManual String?

  status String @default("PENDING_REVIEW") // PENDING_REVIEW|OK|BLOCKED|INTEGRATION_ERROR

  sourceSystem    String
  sourceEntity    String
  sourceId        String
  sourceUpdatedAt DateTime?
  lastSyncAt      DateTime?
  syncStatus      String    @default("SYNCED")

  entries      CommissionEntry[]
  divergencias CommissionDivergence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceSystem, sourceEntity, sourceId, eventType])
  @@index([cnpj])
  @@index([eventType])
  @@index([status])
  @@index([clienteServicoId])
  @@index([clienteId])
  @@index([contratoComercialId])
}

model BusinessProcess {
  id String @id @default(cuid())

  // Fase 3.7 do Cliente Master (2026-08-14): mesma dupla clienteServicoId/clienteId de
  // CommissionEvent, aplicada por consistência mesmo sem dado real hoje (model sempre
  // esteve vazio em produção — nenhum código o escreve ainda).
  clienteServicoId Int?
  clienteServico   ClienteServico? @relation(fields: [clienteServicoId], references: [id])
  clienteId        Int?
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])

  contratoComercialId String?
  contratoComercial   ContratoComercial? @relation(fields: [contratoComercialId], references: [id])

  analistaResponsavelId     Int
  analistaAuxiliarId        Int?
  auditorId                 Int?
  diretorId                 Int?
  dataInicio                DateTime
  dataProtocolo             DateTime?
  dataExito                 DateTime?
  tentativas                Int       @default(1)
  deferidoPrimeiraTentativa Boolean   @default(false)
  status                    String    @default("EM_ANDAMENTO")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  eventos CommissionEvent[]

  @@index([clienteServicoId])
  @@index([clienteId])
  @@index([contratoComercialId])
}

model SyncRun {
  id             String    @id @default(cuid())
  sourceSystem   String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("RUNNING") // RUNNING|SUCCESS|FAILED|PARTIAL
  triggeredBy    String // "manual" | "scheduled"
  triggeredById  Int?
  totalProcessed Int       @default(0)
  totalErrors    Int       @default(0)

  erros SyncError[]
}

model SyncError {
  id           String   @id @default(cuid())
