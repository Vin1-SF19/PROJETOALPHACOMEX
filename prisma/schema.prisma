// ═══════════════════════════════════════════════════════════════════════════
// Gestão de Comissões e Prêmios (módulo novo, 2026-07-28)
// Schema aplicado no Turso via script pontual (Vault, Fase 02 da fila prompt-phases).
// Dinheiro sempre em centavos (Int). FK de usuário sempre Int (usuarios.id).
// ═══════════════════════════════════════════════════════════════════════════

model CommissionEvent {
  id                       String    @id @default(cuid())
  eventType                String // CONTRACTING|PROCESS_STARTED|PROCESS_SUCCESS|FIRST_ATTEMPT_SUCCESS|AUXILIARY_PARTICIPATION|MANUAL_EVENT|CANCELLATION|REVERSAL
  clienteId                Int?
  contratoComercialId      String?
  businessProcessId        String?

  cnpj                     String
  razaoSocial              String
  nomeFantasia             String?
  servico                  String
  eventDate                DateTime

  grossContractAmountCents Int
  partnerSpreadCents       Int    @default(0)
  thirdPartyCostsCents     Int    @default(0)
  discountAmountCents      Int    @default(0)
  netContractAmountCents   Int
  commissionableBaseCents  Int?
  formaPagamento           String?

  // Closer/analista responsável — FK real (preferível, permite navegar até o usuário) quando
  // resolvido via ContratoComercial.usuarioId/BusinessProcess.analistaResponsavelId; nome
  // manual (string, sem FK) quando só existe como texto livre ou foi preenchido à mão porque
  // nenhuma fonte tinha o dado. Nunca inventar um FK a partir de string sem garantia de match.
  closerUsuarioId                Int?
  closerNomeManual               String?
  analistaResponsavelUsuarioId   Int?
  analistaResponsavelNomeManual  String?

  status                   String @default("PENDING_REVIEW") // PENDING_REVIEW|OK|BLOCKED|INTEGRATION_ERROR

  sourceSystem             String
  sourceEntity             String
  sourceId                 String
  sourceUpdatedAt          DateTime?
  lastSyncAt               DateTime?
  syncStatus               String @default("SYNCED")

  entries                  CommissionEntry[]
  divergencias             CommissionDivergence[]

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([sourceSystem, sourceEntity, sourceId, eventType])
  @@index([cnpj])
  @@index([eventType])
  @@index([status])
}

model BusinessProcess {
  id                        String    @id @default(cuid())
  clienteId                 Int?
  contratoComercialId       String?
  analistaResponsavelId     Int
  analistaAuxiliarId        Int?
  auditorId                 Int?
  diretorId                 Int?
  dataInicio                DateTime
  dataProtocolo             DateTime?
  dataExito                 DateTime?
  tentativas                Int       @default(1)
  deferidoPrimeiraTentativa Boolean   @default(false)
  status                    String    @default("EM_ANDAMENTO")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([clienteId])
}

model SyncRun {
  id             String    @id @default(cuid())
  sourceSystem   String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("RUNNING") // RUNNING|SUCCESS|FAILED|PARTIAL
  triggeredBy    String // "manual" | "scheduled"
  triggeredById  Int?
  totalProcessed Int       @default(0)
  totalErrors    Int       @default(0)

  erros          SyncError[]
}

model SyncError {
  id           String   @id @default(cuid())
  syncRunId    String
  syncRun      SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  sourceEntity String
  sourceId     String
  mensagem     String
  detalhesJson String?
  createdAt    DateTime @default(now())

  @@index([syncRunId])
}

model CommissionRule {
  id               String   @id @default(cuid())
  name             String
  description      String?
  active           Boolean  @default(true)
  priority         Int      @default(0)
  eventType        String
  benefitType      String // COMMISSION|BONUS|DSR
  cargoId          Int?
  setorId          Int?
  collaboratorId   Int?
  servico          String?
  approvalRequired Boolean  @default(false)
  createdById      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versoes          CommissionRuleVersion[]
}

model CommissionRuleVersion {
  id                  String    @id @default(cuid())
  ruleId              String
  rule                CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version             Int
  status              String    @default("DRAFT") // DRAFT|PUBLISHED|INACTIVE
  validFrom           DateTime
  validTo             DateTime?
  conditionsJson      String
  calculationJson     String
  paymentScheduleJson String
  publishedById       Int?
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())

  @@unique([ruleId, version])
}

model EligibilityOverride {
  id                   String    @id @default(cuid())
  collaboratorId       Int?
  cargoId              Int?
  clienteId            Int?
  contratoComercialId  String?
  servico              String?
  eventType            String?
  dataInicial          DateTime?
  dataFinal            DateTime?
  tipo                 String // BLOQUEIO|SUBSTITUICAO|PERCENTUAL_ESPECIFICO|VALOR_ESPECIFICO|EXCLUSAO
  percentualEspecifico Float?
  valorEspecificoCents Int?
  justificativa        String
  prioridade           Int       @default(0)
  approvalRequired     Boolean   @default(false)
  aprovadoById         Int?
  aprovadoEm           DateTime?
  createdById          Int
  createdAt            DateTime  @default(now())
}

model CommissionEntry {
  id                       String    @id @default(cuid())
  eventId                  String
  event                    CommissionEvent @relation(fields: [eventId], references: [id])
  collaboratorId           Int
  cargoId                  Int
  vinculo                  String // "CLT" | "PJ" resolvido na data do evento
  ruleVersionId            String?

  totalCents               Int       @default(0)
  status                   String    @default("Pendente") // Pendente|AguardandoAprovacao|Programado|Pago|ParcialmentePago|Vencido|Bloqueado|EmDivergencia|Cancelado|Estornado

  contractualDueDate       DateTime?
  operationalSuggestedDate DateTime?
  scheduledPaymentDate     DateTime?
  actualPaymentDate        DateTime?

  componentes              EntryComponent[]
  ajustes                  ManualAdjustment[]
  alocacoes                PaymentAllocation[]
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([eventId, collaboratorId])
  @@index([collaboratorId])
  @@index([status])
}

model EntryComponent {
  id                 String   @id @default(cuid())
  entryId            String
  entry              CommissionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tipo               String // COMISSAO|PREMIO|DSR|AJUSTE
  valorCents         Int
  percentual         Float?
  memoriaCalculoJson String
  createdAt          DateTime @default(now())
}

model ManualAdjustment {
  id                 String    @id @default(cuid())
  entryId            String
  entry              CommissionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  valorOriginalCents Int
  valorAjustadoCents Int
  justificativa      String
  aprovadoById       Int?
  aprovadoEm         DateTime?
  createdById        Int
  createdAt          DateTime  @default(now())
}

model Payment {
  id                    String   @id @default(cuid())
  data                  DateTime
  valorCents            Int
  meio                  String
  referencia            String?
  observacao            String?
  comprovanteUrl        String?
  usuarioResponsavelId  Int
  tipo                  String   @default("PAGAMENTO") // PAGAMENTO|ESTORNO
  estornoDeId           String?
  createdAt             DateTime @default(now())

  alocacoes             PaymentAllocation[]
}

model PaymentAllocation {
  id         String  @id @default(cuid())
  paymentId  String
  payment    Payment @relation(fields: [paymentId], references: [id])
  entryId    String
  entry      CommissionEntry @relation(fields: [entryId], references: [id])
  valorCents Int

  @@index([entryId])
}

model TariffVersion {
  id                       String    @id @default(cuid())
  servico                  String
  valorCents               Int
  dataInicial              DateTime
  dataFinal                DateTime?
  formasPagamentoJson      String
  descontoPadraoPercentual Float?
  condicoesJson            String?
  createdAt                DateTime  @default(now())
}

model CommissionDivergence {
  id            String    @id @default(cuid())
  eventId       String?
  event         CommissionEvent? @relation(fields: [eventId], references: [id])
  entryId       String?
  tipo          String // as 14 checagens da seção 28 do prompt original
  severidade    String // PENDING_REVIEW|BLOCKED|INTEGRATION_ERROR
  detalhes      String
  resolvidoEm   DateTime?
  resolvidoById Int?
  createdAt     DateTime  @default(now())
}

model ExportDocument {
  id                String   @id @default(cuid())
  tipo              String // comissoes|premios|comissao_dsr|todos
  colaboradorId     Int?
  periodoInicio     DateTime
  periodoFim        DateTime
  formato           String // PDF|XLSX|AMBOS
  codigoVerificacao String   @unique
  hash              String
  geradoPorId       Int
  createdAt         DateTime @default(now())

  itens             ExportDocumentItem[]
}

model ExportDocumentItem {
  id         String  @id @default(cuid())
  documentId String
  document   ExportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entryId    String?
  linhaJson  String
}

model Holiday {
  id        String   @id @default(cuid())
  data      DateTime
  nome      String
  escopo    String // NACIONAL|ESTADUAL|MUNICIPAL
  uf        String?
  municipio String?

  @@index([data])
}

model CommissionAuditLog {
  id            String   @id @default(cuid())
  userId        Int
  acao          String
  entityType    String
  entityId      String
  beforeJson    String?
  afterJson     String?
  reason        String?
  ipAddress     String?
  userAgent     String?
  correlationId String
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([correlationId])
}

/**
 * RBAC granular por ação dentro do módulo de Comissões — substitui a checagem hardcoded
 * `ROLES_TEMPORARIAMENTE_PERMITIDOS` presente em 12 Server Actions. Categoria (não ação
 * individual — 33 funções reais agrupadas em 6 categorias funcionais, decisão do usuário):
 * VISUALIZAR (listar/ver detalhes), SINCRONIZAR, PAGAR (registrar/programar/estornar/lote),
 * APROVAR (eventos/divergências/ajustes), CONFIGURAR (cargos/tarifários/regras/feriados/
 * exceções), EXPORTAR. Admin/CEO sempre têm acesso total, independente desta tabela
 * (bypass já existente em todo o módulo, mantido).
 */
model CommissionPermission {
  id        String   @id @default(cuid())
  userId    Int
  categoria String // VISUALIZAR|SINCRONIZAR|PAGAR|APROVAR|CONFIGURAR|EXPORTAR
  permitido Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoria])
  @@index([userId])
}

model ChecklistDocumental {
  id        String   @id @default(cuid())
  usuarioId Int      @unique
  usuario   usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  carteiraTrabalho      Boolean @default(false)
  pis                   Boolean @default(false)
  identidade            Boolean @default(false)
  cpfDoc                Boolean @default(false)
  cnh                   Boolean @default(false)
  tituloEleitor         Boolean @default(false)
  reservista            Boolean @default(false)
  comprovanteResidencia Boolean @default(false)
  certidao              Boolean @default(false)
  foto3x4               Boolean @default(false)
  exameAdmissional      Boolean @default(false)
  escolaridade          Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("checklist_documental")
}

// ─── Bibble Chat ──────────────────────────────────────────────────────────────

model BibbleProject {
  id           String          @id @default(cuid())
  userId       Int
  title        String
  systemPrompt String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     BibbleSession[]
  user         usuarios        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bibble_project")
}

model BibbleSession {
  id            String          @id @default(cuid())
  userId        Int
  title         String          @default("Nova conversa")
  projectId     String?
  // Sessão Onyx vinculada (quando a conversa é com um agente Onyx). É a fonte de
  // verdade do histórico dessa conversa — texto + imagens vêm do Onyx via
  // GET /chat/get-chat-session/{id}. NULL = conversa Bibble/Ollama (histórico local).
  onyxSessionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      BibbleMessage[]
  user          usuarios        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       BibbleProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("bibble_session")
}

model BibbleMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String
  content   String
  tokens    Int?
  createdAt DateTime      @default(now())
  session   BibbleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("bibble_message")
}

// ─── Onyx ─────────────────────────────────────────────────────────────────────
// Vincula cada agente criado no Onyx (conta de serviço única) ao usuário do
// PainelAlpha que o criou. Permite filtrar/gerenciar agentes por dono sem
// precisar criar usuários no Onyx.
model OnyxAgentOwner {
  id          Int      @id @default(autoincrement())
  onyxAgentId Int      @unique
  userId      Int
  agentName   String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("onyx_agent_owner")
}

// Agentes fixados pelo usuário no chat IAlpha (máx. 3). Segue o usuário entre dispositivos.
model OnyxAgenteFixado {
  id          Int      @id @default(autoincrement())
  userId      Int
  onyxAgentId Int
  agentName   String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, onyxAgentId])
  @@index([userId])
  @@map("onyx_agente_fixado")
}

// ─── Parceiros ────────────────────────────────────────────────────────────────

model Parceiro {
  id                 Int                     @id @default(autoincrement())
  tipo               String // "PF" | "PJ"
  tipoParceiro       String                  @default("PADRAO") // "PADRAO" | "SEM_COMISSAO" | "ESPECIAL"
  documento          String                  @unique
  nome               String
  nomeFantasia       String?
  dataNascimento     String? // só preenchido quando tipo=PF
  sobre              String? // "fale mais sobre você/sua empresa" — herdado do pré-cadastro (convite)
  email              String
  nomeBanco          String?
  agencia            String?
  conta              String?
  chavePix           String?
  tipoChavePix       String?
  pixConfirmado      Boolean                 @default(false)
  pixConfirmadoEm    DateTime?
  nivel              String                  @default("GOLD")
  nivelAtualizadoEm  DateTime? // base da janela de 60 dias (promoção/rebaixamento)
  comissaoPercentual Float? // override manual opcional (lógica futura)
  dadosConsulta      String?
  telefone           String?
  telefone2          String?
  loginEmail         String
  senhaHash          String
  // ─── Onboarding / termo de adesão (portal AlphaParceiros) ──────────────────
  senhaTemporaria    Boolean                 @default(true)
  onboardingCompleto Boolean                 @default(false)
  termoAceito        Boolean                 @default(false)
  termoAceitoEm      DateTime?
  termoVersao        String?
  // ─── Ativação de acesso (admin pode desativar sem excluir o cadastro) ──────
  ativo              Boolean                 @default(true)
  desativadoEm       DateTime?
  desativadoPorId    Int?
  criadoPorId        Int
  criadoPor          usuarios                @relation(fields: [criadoPorId], references: [id])
  endereco           ParceiroEndereco?
  responsaveis       ParceiroResponsavel[]
  representantes     ParceiroRepresentante[]
  indicacoes         Indicacao[]
  convitesGerados    ConviteParceiro[]       @relation("ConvitesPorParceiro")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([documento])
  @@index([criadoPorId])
  @@map("parceiros")
}

// Indicação: vincula um Parceiro a uma empresa do CS&NPS (model `clientes`).
// Fonte de verdade tanto do fluxo "Nova Indicação" quanto do canal de aquisição no Metas.
model Indicacao {
  id                    Int       @id @default(autoincrement())
  parceiroId            Int
  parceiro              Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  clienteId             Int       @unique // uma empresa é indicada por no máximo 1 parceiro
  cliente               clientes  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataIndicacao         DateTime  @default(now())
  status                String    @default("ATIVA") // "ATIVA" | "DESVINCULADA"
  criadoPorId           Int
  criadoPor             usuarios  @relation("IndicacaoAutor", fields: [criadoPorId], references: [id])
  // Comprovante de comissão (enviado no PainelAlpha, visto no portal do parceiro)
  comprovanteUrl        String?
  comprovanteNome       String?
  comprovanteTipo       String? // mime type
  comprovanteEnviadoEm  DateTime?
  comprovanteEnviadoPor String?
  createdAt             DateTime  @default(now())

  @@index([parceiroId])
  @@index([clienteId])
  @@map("indicacoes")
}

// Permissões do módulo de Parceiros (geridas pelo Admin via engrenagem).
// Admin/CEO sempre têm acesso total e NÃO dependem desta tabela.
model ParceiroAcesso {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)
  podeEditar  Boolean  @default(false)
  podeExcluir Boolean  @default(false)
  /// Pode aprovar/rejeitar pré-cadastros de parceiro (wizard de convite) mesmo
  /// não sendo Admin/CEO — 3º toggle da tela "Controle de Acesso"
  /// (ModalEngrenagem.tsx), ao lado de Editar/Excluir.
  podeAprovar Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("parceiro_acesso")
}

model ParceiroEndereco {
  id          Int      @id @default(autoincrement())
  parceiroId  Int      @unique
  parceiro    Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  cep         String
  logradouro  String
  numero      String?
  complemento String?
  bairro      String
  cidade      String
  uf          String

  @@map("parceiro_endereco")
}

model ParceiroResponsavel {
  id             Int      @id @default(autoincrement())
  parceiroId     Int
  parceiro       Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  nome           String
  cpf            String
  dataNascimento String
  cargo          String?

  @@index([parceiroId])
  @@map("parceiro_responsavel")
}

// Representantes cadastrados pelo parceiro no portal AlphaParceiros (manual, N por parceiro).
model ParceiroRepresentante {
  id             Int      @id @default(autoincrement())
  parceiroId     Int
  parceiro       Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  tipo           String
  documento      String
  nome           String
  dataNascimento String?
  cargo          String?
  email          String?
  telefone       String?
  createdAt      DateTime @default(now())

  @@index([parceiroId])
  @@map("parceiro_representante")
}

// Termo de adesão editável pelo Admin (sem mexer no código). O parceiro lê a
// versão ATIVA no onboarding do portal. Mantém histórico de versões.
model ParceiroTermo {
  id          Int      @id @default(autoincrement())
  versao      String // ex: "v1-2026"
  conteudo    String // texto do termo (markdown/plano)
  ativo       Boolean  @default(true)
  criadoPorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("parceiro_termo")
}

// ─── Convite de parceiro (link temporário) ────────────────────────────────────
// Gera um link público com token; o convidado preenche o form → vira PreCadastro.
model ConviteParceiro {
  id                  Int                   @id @default(autoincrement())
  token               String                @unique // token do link (randomUUID)
  status              String                @default("PENDENTE") // PENDENTE | USADO | REVOGADO | EXPIRADO
  expiraEm            DateTime // validade do link
  usoUnico            Boolean               @default(true)
  // PIN de 4 dígitos — protege a consulta automática de CPF (custo por chamada
  // na InfoSimples). Nullable: convites gerados antes desta feature não têm PIN
  // e por isso NÃO liberam a busca automática (ver rota /api/convite/consulta-cpf).
  pin                 String?
  // Rate-limit de tentativas de PIN — compartilhado entre StepPin (entrada no
  // wizard) e a consulta automática de CPF. 5 tentativas erradas suspende por 1min.
  tentativasPin       Int                   @default(0)
  suspensoAte         DateTime?
  // Quem gerou: um usuário do Painel OU um parceiro existente (indicação).
  criadoPorUserId     Int?
  criadoPorParceiroId Int?
  criadoPorUser       usuarios?             @relation("ConvitesCriados", fields: [criadoPorUserId], references: [id], onDelete: SetNull)
  criadoPorParceiro   Parceiro?             @relation("ConvitesPorParceiro", fields: [criadoPorParceiroId], references: [id], onDelete: SetNull)
  preCadastros        PreCadastroParceiro[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([token])
  @@index([status])
  @@map("convite_parceiro")
}

// Respostas do formulário público (espelho do Google Forms). Fica como
// pré-cadastro até um admin aprovar e converter em Parceiro de verdade.
model PreCadastroParceiro {
  id                  Int              @id @default(autoincrement())
  conviteId           Int?
  convite             ConviteParceiro? @relation(fields: [conviteId], references: [id], onDelete: SetNull)
  // Campos do formulário
  email               String
  nomeCompleto        String
  cpf                 String?
  dataNascimento      String? // usada na consulta automática de CPF (InfoSimples)
  dadosConsultaCpf    String? // JSON bruto da resposta InfoSimples (CPF)
  uf                  String
  municipio           String?
  telefone            String
  whatsapp            String?
  // Endereço estruturado (wizard multi-tela com busca de CEP)
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  areasAtuacao        String? // CSV das áreas selecionadas
  nomeEmpresa         String? // campo legado — mantido por compatibilidade
  razaoSocial         String? // preenchido pela consulta automática de CNPJ
  nomeFantasia        String? // preenchido pela consulta automática de CNPJ
  cnpj                String?
  dadosConsultaCnpj   String? // JSON bruto da resposta ReceitaFederal (CNPJ)
  sobre               String? // "fale mais sobre você/empresa"
  tipoRecebimento     String? // "PF" | "PJ" — escolha explícita feita no wizard (Step Tipo). Null = pré-cadastros antigos, cai no fallback por CNPJ.
  souRepresentante    Boolean          @default(true) // se PJ: true = o próprio preenchedor (nomeCompleto/cpf/dataNascimento) é o representante; false = usa representantesExtra
  representantesExtra String? // JSON stringificado de { nome, cpf, dataNascimento, cargo }[] — só quando souRepresentante=false
  // Aceite do termo (versão capturada no momento do aceite)
  termoVersao         String
  termoAceito         Boolean          @default(true)
  termoAceitoEm       DateTime         @default(now())
  // Fluxo de aprovação
  status              String           @default("PENDENTE") // PENDENTE | APROVADO | REJEITADO
  parceiroId          Int? // preenchido quando aprovado (vira Parceiro)
  aprovadoPorId       Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([conviteId])
  @@map("pre_cadastro_parceiro")
}

// Config singleton do módulo Parceiros (1 linha). Controla flags globais.
model ParceiroConfig {
  id                        Int      @id @default(1)
  permitirParceiroConvidar  Boolean  @default(false)
  validadeConvitePadraoDias Int      @default(7)
  updatedAt                 DateTime @updatedAt

  @@map("parceiro_config")
}

// ─── Alpha Presentation Studio ────────────────────────────────────────────────
// Editor de apresentações HTML interativas. Conteúdo de cada slide é guardado
// como JSON (Slide.dadosJson) — não relacional — decisão registrada em
// decisions.md (2026-07-09, "arquitetura de dados do slide").

model Apresentacao {
  id            String                    @id @default(cuid())
  titulo        String
  clienteNome   String?
  autorId       Int
  autor         usuarios                  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  status        String                    @default("DRAFT") // DRAFT | PUBLICADA | ARQUIVADA
  temaId        String?
  tema          ApresentacaoTema?         @relation(fields: [temaId], references: [id])
  thumbnailUrl  String?
  slugPublico   String?                   @unique
  senhaAcesso   String?
  expiraEm      DateTime?
  slides        Slide[]
  assets        ApresentacaoAsset[]
  versoes       ApresentacaoVersao[]
  colaboradores ApresentacaoColaborador[]
  comentarios   ApresentacaoComentario[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([autorId])
  @@index([status])
}

model Slide {
  id               String                   @id @default(cuid())
  apresentacaoId   String
  apresentacao     Apresentacao             @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  ordem            Int
  nome             String?
  transicaoEntrada String?
  duracaoAutoplay  Int?
  dadosJson        Json
  comentarios      ApresentacaoComentario[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([apresentacaoId, ordem])
}

model ApresentacaoTema {
  id              String         @id @default(cuid())
  nome            String
  corPrimaria     String
  corSecundaria   String
  corAccent       String
  radius          String?
  fontePrimaria   String?
  fonteSecundaria String?
  tokensJson      Json
  isTemplate      Boolean        @default(false)
  criadoPorId     Int?
  apresentacoes   Apresentacao[]
  createdAt       DateTime       @default(now())
}

model ApresentacaoAsset {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  tipo           String // IMAGEM | VIDEO | MODELO_3D | AUDIO | FONTE
  url            String
  nomeOriginal   String
  tamanhoBytes   Int
  createdAt      DateTime     @default(now())

  @@index([apresentacaoId])
}

model ApresentacaoVersao {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  dadosJson      Json
  criadoPorId    Int
  label          String?
  createdAt      DateTime     @default(now())

  @@index([apresentacaoId, createdAt])
}

model ApresentacaoColaborador {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  userId         Int
  user           usuarios     @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel          String       @default("EDITOR") // EDITOR | VISUALIZADOR | COMENTARISTA

  @@unique([apresentacaoId, userId])
}

model ApresentacaoComentario {
  id             String       @id @default(cuid())
  apresentacaoId String
  apresentacao   Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)
  slideId        String?
  slide          Slide?       @relation(fields: [slideId], references: [id], onDelete: SetNull)
  autorId        Int
  autor          usuarios     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto          String
  resolvido      Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ─── Calendário Alpha (Google Calendar via Domain-Wide Delegation) — MVP, sem webhook/vínculos internos ───
// Ver docs/stories/story-calendario-alpha.md. Arquitetura 2026-07-17: Service Account com impersonation
// (subject = usuarios.email, que é o mesmo e-mail do Google Workspace) — NÃO há OAuth por usuário nem
// token individual a persistir/criptografar. O acesso real é concedido em bloco pelo Super Admin do
// Workspace no Admin Console; `status` aqui é só a ativação/preferência do usuário dentro do Painel.

model GoogleCalendarConexao {
  id     String   @id @default(cuid())
  userId Int      @unique
  user   usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("ATIVA") // ATIVA | DESATIVADA — não revoga o acesso do Service Account, só a exibição/uso no Painel

  ativadoEm    DateTime  @default(now())
  desativadoEm DateTime?

  ultimaSincronizacaoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarios GoogleCalendarSelecionado[]

  @@index([status])
}

model GoogleCalendarSelecionado {
  id        String                @id @default(cuid())
  conexaoId String
  conexao   GoogleCalendarConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  googleCalendarId String
  nome             String
  corHex           String?
  timezone         String
  papelAcesso      String // owner | writer | reader | freeBusyReader

  visivel  Boolean @default(true)
  gravavel Boolean @default(false)

  syncToken             String?
  ultimaSincronizacaoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos           GoogleCalendarEventoCache[]
  pushChannels      GoogleCalendarPushChannel[]
  pendingOperations GoogleCalendarPendingOperation[]
  syncLease         GoogleCalendarSyncLease?

  @@unique([conexaoId, googleCalendarId])
}

/// Cache local mínimo por evento sincronizado — só o necessário para renderizar as visões e
/// suportar sync incremental por syncToken (idempotência via googleEventId). Google Calendar
/// continua sendo a fonte de verdade; descrição, participantes e link do Meet NÃO são
/// persistidos aqui e são buscados sob demanda ao abrir o detalhe do evento.
model GoogleCalendarEventoCache {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  googleEventId String
  status        String // confirmed | tentative | cancelled
  titulo        String?
  inicioEm      DateTime?
  fimEm         DateTime?
  diaInteiro    Boolean   @default(false)
  etag          String
  linkMeet      String?

  atualizadoGoogleEm DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([calendarioId, googleEventId])
  @@index([calendarioId, inicioEm])
}

/// Canal push registrado no Google Calendar. O token persistido é somente o hash usado para
/// autenticar notificações; o valor secreto nunca é armazenado em texto puro.
model GoogleCalendarPushChannel {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  googleChannelId  String  @unique
  googleResourceId String?
  resourceUri      String?
  channelTokenHash String

  status     String   @default("CREATING") // CREATING | ACTIVE | STOPPING | STOPPED | EXPIRED | ERROR
  expiresAt  DateTime
  renewAfter DateTime

  activatedAt DateTime?
  stoppedAt   DateTime?

  lastMessageNumber  String?
  lastNotificationAt DateTime?
  lastErrorCode       String?
  lastErrorAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pendingOperations GoogleCalendarPendingOperation[]

  @@index([status, renewAfter])
  @@index([calendarioId, status, expiresAt])
}

/// Fila persistente at-least-once para sincronização e manutenção de canais. O idempotencyKey
/// impede enfileiramento duplicado e claimToken oferece fencing durante reclaims.
model GoogleCalendarPendingOperation {
  id           String                    @id @default(cuid())
  calendarioId String
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  pushChannelId String?
  pushChannel   GoogleCalendarPushChannel? @relation(fields: [pushChannelId], references: [id], onDelete: SetNull)

  operationType  String // SYNC_CALENDAR | RENEW_CHANNEL | STOP_CHANNEL | RECONCILE_CHANNEL
  source         String // WEBHOOK | MANUAL | SCHEDULED | ADMIN
  idempotencyKey String @unique
  payloadJson    String?

  status       String   @default("PENDING") // PENDING | PROCESSING | RETRY | SUCCEEDED | DEAD_LETTER | CANCELLED
  priority     Int      @default(100)
  attemptCount Int      @default(0)
  maxAttempts  Int      @default(8)
  availableAt  DateTime @default(now())

  claimedBy      String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  claimToken     Int       @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?
  deadLetteredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, priority, createdAt])
  @@index([status, claimExpiresAt])
  @@index([calendarioId, operationType, status])
  @@index([pushChannelId])
}

/// Lease distribuído por calendário. O fencingToken cresce a cada aquisição para impedir que
/// workers antigos confirmem trabalho depois de perder o lease.
model GoogleCalendarSyncLease {
  id           String                    @id @default(cuid())
  calendarioId String                    @unique
  calendario   GoogleCalendarSelecionado @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  ownerId        String
  fencingToken   Int      @default(1)
  leaseExpiresAt DateTime
  heartbeatAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseExpiresAt])
}

/// Compartilhamento de agenda entre colegas (cultura interna: todo mundo vê a agenda de todo
/// mundo para marcar reunião em horário livre). Não é um "convite" que o dono aprova — qualquer
/// usuário pode adicionar outro à própria lista de visualização (mesmo espírito de confiança
/// interna descrito pelo usuário). `cor` é atribuída automaticamente na criação, para diferenciar
/// visualmente cada colega na grade. Admin/CEO enxergam qualquer colega mesmo sem esta linha
/// existir (ver `verificarAcessoColega` em `colegas.ts`) — esta tabela só controla o "meu mural".
model GoogleCalendarColegaVisivel {
  id       String  @id @default(cuid())
  userId   Int // quem está vendo (o "viewer")
  colegaId Int // o colega cuja agenda aparece na visão do viewer
  cor      String // hex atribuído para diferenciar este colega na grade do viewer
  visivel  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewer usuarios @relation("ColegaViewer", fields: [userId], references: [id], onDelete: Cascade)
  colega usuarios @relation("ColegaDono", fields: [colegaId], references: [id], onDelete: Cascade)

  @@unique([userId, colegaId])
  @@index([colegaId])
}

/// Permissão administrativa para usar o compartilhamento de agenda entre colegas (Calendário
/// Alpha). Presença de uma linha = usuário permitido a adicionar/ser adicionado por colegas.
/// Admin/CEO sempre tem acesso pleno independente desta tabela (ver `isAdminRole`).
model GoogleCalendarPermissaoColegas {
  userId       Int      @id
  user         usuarios @relation("PermissaoColegasCalendario", fields: [userId], references: [id], onDelete: Cascade)
  concedidoPor Int
  createdAt    DateTime @default(now())
}

// ─── Alpha Blueprint (central de especificação de sistemas) ──────────────────
// Aprovado por Vault em 2026-07-27 (🟢 — 9 CREATE TABLE novas, sem alteração
// em tabela existente). Ver blueprint completo do Scout / aprovação do Vault
// no journal desta sessão.

model BlueprintProject {
  id                  String    @id @default(cuid())
  code                String    @unique
  title               String
  slug                String?
  summary             String?
  problem             String?
  objective           String?

  status              String    @default("IDEA")
  priority            String    @default("NORMAL")
  progress            Int       @default(0)
  progressDetailsJson String?

  setor        String?
  requesterId  Int
  ownerId      Int?
  developerId  Int?

  dueDate    DateTime?
  coverUrl   String?
  icon       String?
  tagsJson   String?
  premioCents Int?

  createdById Int
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  documents    BlueprintDocument[]
  boards       BlueprintBoard[]
  files        BlueprintFile[]
  requirements BlueprintRequirement[]
  questions    BlueprintQuestion[]
  comments     BlueprintComment[]
  members      BlueprintMember[]
  activities   BlueprintActivity[]

  requester usuarios  @relation("BlueprintRequester", fields: [requesterId], references: [id])
  owner     usuarios? @relation("BlueprintOwner", fields: [ownerId], references: [id])
  developer usuarios? @relation("BlueprintDeveloper", fields: [developerId], references: [id])
  createdBy usuarios  @relation("BlueprintCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([priority])
  @@index([setor])
  @@index([requesterId])
  @@index([ownerId])
  @@index([updatedAt])
}

model BlueprintMember {
  id              String   @id @default(cuid())
  projectId       String
  userId          Int
  role            String
  permissionsJson String?
  addedById       Int
  createdAt       DateTime @default(now())

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usuario usuarios         @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model BlueprintDocument {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  contentJson String
  contentText String?
  order       Int      @default(0)
  createdById Int
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BlueprintBoard {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  viewportJson String?
  elementsJson String
  version      Int      @default(1)
  createdById  Int
  updatedById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BlueprintFile {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  originalName String
  description  String?
  category     String?
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  metadataJson String?
  uploadedById Int
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([mimeType])
}

model BlueprintRequirement {
  id                 String   @id @default(cuid())
  projectId          String
  code               String
  title              String
  description        String?
  type               String
  status             String   @default("RASCUNHO")
  priority           String   @default("NORMAL")
  acceptanceCriteria String?
  sourceType         String?
  sourceId           String?
  assigneeId         Int?
  dependenciesJson   String?
  createdById        Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([projectId])
  @@index([status])
}

model BlueprintQuestion {
  id           String    @id @default(cuid())
  projectId    String
  question     String
  answer       String?
  status       String    @default("ABERTA")
  priority     String    @default("NORMAL")
  authorId     Int
  assignedToId Int?
  sourceType   String?
  sourceId     String?
  answeredById Int?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
}

model BlueprintComment {
  id           String    @id @default(cuid())
  projectId    String
  parentId     String?
  targetType   String
  targetId     String?
  content      String
  authorId     Int
  resolved     Boolean   @default(false)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([targetType, targetId])
}

model BlueprintActivity {
  id                String   @id @default(cuid())
  projectId         String
  userId            Int
  action            String
  entityType        String
  entityId          String?
  previousValueJson String?
  newValueJson      String?
  metadataJson      String?
  createdAt         DateTime @default(now())

  project BlueprintProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// ─── Alpha BPM (2026-08-03) ───────────────────────────────────────────────────
// Sistema de BPM/gestão de processos. Empresa = `clientes`, Pessoa = `socios`,
// Setor = `Setor` (já existentes, reaproveitados — D-049). Card é a unidade central:
// 1 card = 1 execução de processo/demanda, sempre vinculado a uma empresa (D-021).
// Etapas/campos/SLA são metadados configuráveis via UI por pipeline (D-013), não enum fixo.

model BpmPipeline {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setores       BpmPipelineSetor[]
  etapas        BpmEtapa[]
  campos        BpmCampo[]
  cards         BpmCard[]
  configAuditoria BpmPipelineConfigAuditoria[]

  @@index([ativo])
}

model BpmPipelineSetor {
  id         String @id @default(cuid())
  pipelineId String
  setorId    Int

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  setor    Setor       @relation(fields: [setorId], references: [id])

  @@unique([pipelineId, setorId])
  @@index([setorId])
}

model BpmEtapa {
  id         String  @id @default(cuid())
  pipelineId String
  nome       String
  ordem      Int     @default(0)
  slaDias    Int?
  ativo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  campos   BpmCampo[]
  cards    BpmCard[]

  @@index([pipelineId])
  @@index([pipelineId, ordem])
}

model BpmCampo {
  id         String  @id @default(cuid())
  pipelineId String
  etapaId    String?
  nome       String
  tipo       String // "texto" | "numero" | "data" | "selecao" | "booleano" (validado via Zod na action)
  opcoesJson String? // opções quando tipo = "selecao"
  obrigatorio Boolean @default(false)
  ordem      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  etapa    BpmEtapa?   @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  valores  BpmCardCampoValor[]

  @@index([pipelineId])
  @@index([etapaId])
}

model BpmCard {
  id         String  @id @default(cuid())
  empresaId  Int
  pipelineId String
  etapaId    String
  responsavelId Int
  servico    String?
  status     String  @default("ATIVO") // "ATIVO" | "CONCLUIDO" | "CANCELADO"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidoEm DateTime?

  empresa     clientes    @relation(fields: [empresaId], references: [id])
  pipeline    BpmPipeline @relation(fields: [pipelineId], references: [id])
  etapa       BpmEtapa    @relation(fields: [etapaId], references: [id])
  responsavel usuarios    @relation("BpmCardResponsavel", fields: [responsavelId], references: [id])

  campoValores BpmCardCampoValor[]
  membros      BpmCardMembro[]
  tarefas      BpmTarefa[]
  historico    BpmCardHistorico[]
  anexos       BpmCardAnexo[]

  vinculosOrigem  BpmCardVinculo[] @relation("CardOrigem")
  vinculosDestino BpmCardVinculo[] @relation("CardDestino")

  @@index([empresaId])
  @@index([pipelineId])
  @@index([etapaId])
  @@index([responsavelId])
  @@index([status])
}

model BpmCardCampoValor {
  id      String @id @default(cuid())
  cardId  String
  campoId String
  valor   String?

  card  BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  campo BpmCampo @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([cardId, campoId])
  @@index([campoId])
}

model BpmCardMembro {
  id       String   @id @default(cuid())
  cardId   String
  userId   Int
  role     String // "RESPONSAVEL" | "ADMINISTRADOR" | "PARTICIPANTE"
  createdAt DateTime @default(now())

  card    BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  usuario usuarios @relation(fields: [userId], references: [id])

  @@unique([cardId, userId])
  @@index([userId])
}

model BpmCardVinculo {
  id             String   @id @default(cuid())
  cardOrigemId   String
  cardDestinoId  String
  createdAt      DateTime @default(now())

  cardOrigem  BpmCard @relation("CardOrigem", fields: [cardOrigemId], references: [id], onDelete: Cascade)
  cardDestino BpmCard @relation("CardDestino", fields: [cardDestinoId], references: [id], onDelete: Cascade)

  @@unique([cardOrigemId, cardDestinoId])
  @@index([cardDestinoId])
}

model BpmTarefa {
  id            String    @id @default(cuid())
  cardId        String
  titulo        String
  descricao     String?
  responsavelId Int?
  prazo         DateTime?
  prioridade    String    @default("NORMAL") // "BAIXA" | "NORMAL" | "ALTA"
  status        String    @default("PENDENTE") // "PENDENTE" | "CONCLUIDA"
  checklistJson String?
  presetId      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidaEm DateTime?

  card        BpmCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  responsavel usuarios?      @relation(fields: [responsavelId], references: [id])
  preset      BpmTarefaPreset? @relation(fields: [presetId], references: [id])

  @@index([cardId])
  @@index([responsavelId])
  @@index([status])
}

model BpmTarefaPreset {
  id          String  @id @default(cuid())
  pipelineId  String?
  nome        String
  descricao   String?
  tipoGeracao String  @default("UNICA") // "UNICA" | "MULTIPLA" | "FLUXO" (configurável via UI — D-026)
  templateJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarefas BpmTarefa[]

  @@index([pipelineId])
}

model BpmCardHistorico {
  id               String   @id @default(cuid())
  cardId           String
  acao             String
  valorAnteriorJson String?
  valorNovoJson     String?
  usuarioId        Int?
  automacaoOrigem  String?
  createdAt        DateTime @default(now())

  card    BpmCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  usuario usuarios? @relation(fields: [usuarioId], references: [id])

  @@index([cardId])
  @@index([createdAt])
}

model BpmPipelineConfigAuditoria {
  id             String   @id @default(cuid())
  pipelineId     String
  adminId        Int
  campoAlterado  String
  valorAnteriorJson String?
  valorNovoJson     String?
  createdAt      DateTime @default(now())

  pipeline BpmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  admin    usuarios    @relation(fields: [adminId], references: [id])

  @@index([pipelineId])
  @@index([createdAt])
}

model BpmCardAnexo {
  id        String   @id @default(cuid())
  cardId    String
  url       String
  nome      String
  tipo      String?
  tamanho   Int?
  enviadoPorId Int
  createdAt DateTime @default(now())

  card       BpmCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  enviadoPor usuarios @relation(fields: [enviadoPorId], references: [id])

  @@index([cardId])
}

model PessoaEmpresaVinculo {
  id        String  @id @default(cuid())
  pessoaId  Int
  empresaId Int
  funcao    String?

  createdAt DateTime @default(now())

  pessoa  socios   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  empresa clientes @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, empresaId])
  @@index([empresaId])
}
