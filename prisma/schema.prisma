generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model usuarios {
  id                 Int                @id @default(autoincrement())
  nome               String
  usuario            String             @unique
  email              String             @unique
  senha              String
  role               String             @default("User")
  permissoes         String?
  chamados_criados   chamados[]         @relation("Solicitante")
  mensagens          MensagensChamado[]
  Auditoria          Auditoria[]
  imagemUrl          String?
  esconderBloqueados Boolean            @default(false)
  ultimo_aviso       String?

  atalhos          String? @default("radar,chamados")
  tema_interface   String? @default("blue")
  densidade_painel String? @default("default")
  bibble_ativo     Boolean @default(true)

  // Onboarding: vídeo obrigatório de introdução ao IAlpha (some após marcar visto)
  onboarding_ialpha_visto Boolean @default(false)
  // Onboarding: tour guiado do módulo Alpha Blueprint (some após marcar visto, botão "? Ajuda" reabre)
  onboarding_blueprint_visto Boolean @default(false)

  cargo            String?
  data_contratacao String?
  status           String  @default("ATIVO")

  cpf                  String?
  data_nascimento      String?
  telefone             String?
  telefone_corporativo String?
  contato_emerg_1_nome String?
  contato_emerg_1_tel  String?
  contato_emerg_2_nome String?
  contato_emerg_2_tel  String?
  observacoes_internas String?

  meta_visivel_painel Boolean @default(true)

  contratosColaborador ContratoColaborador[]
  checklistDocumental  ChecklistDocumental?

  reset_token   String?
  reset_expires DateTime?

  // Token (PAT) individual do usuário no Onyx. Opcional: quando preenchido, as
  // chamadas ao Onyx usam este token (identidade real do usuário); quando NULL,
  // cai no PAT de serviço (ONYX_API_KEY). NUNCA expor ao cliente nem logar.
  token_onyx String?

  mensagensEnviadas  mensagens[] @relation("Enviadas")
  mensagensRecebidas mensagens[] @relation("Recebidas")

  tarefas Tarefa[]

  conversasP1 conversas[] @relation("ConversaP1")
  conversasP2 conversas[] @relation("ConversaP2")

  presets          Preset[]         @relation("PresetTousuarios")
  progressosVideos ProgressoVideo[]
  resultadosProvas ResultadoProva[]

  holeritesColaborador Holerite[]                 @relation("HoleriteColaborador")
  holeriteUploads      Holerite[]                 @relation("HoleriteUploader")
  popAcessos           PopAcesso[]                @relation("PopAcessoUsuario")
  permissaoOverrides   UsuarioPermissaoOverride[]
  contratosComerciais  ContratoComercial[]        @relation("ContratosComerciais")
  holeriteAlertas      HoleriteAlertaHistorico[]

  senhaTemporaria  Boolean   @default(false)
  primeiroAcessoEm DateTime?

  bibbleSessions BibbleSession[]
  bibbleProjects BibbleProject[]

  onyxAgents         OnyxAgentOwner[]
  onyxAgentesFixados OnyxAgenteFixado[]

  historicoAlteracoesCliente HistoricoAlteracaoCliente[]

  parceirosCriados        Parceiro[]
  indicacoesCriadas       Indicacao[]       @relation("IndicacaoAutor")
  parceiroAcessos         ParceiroAcesso[]
  convitesParceiroCriados ConviteParceiro[] @relation("ConvitesCriados")

  apresentacoesCriadas     Apresentacao[]
  apresentacaoColaboracoes ApresentacaoColaborador[]
  apresentacaoComentarios  ApresentacaoComentario[]

  videosIntrodutorioAtivados VideoIntrodutorioConfig[]

  googleCalendarConexao GoogleCalendarConexao?

  colegasQueEuVejo GoogleCalendarColegaVisivel[] @relation("ColegaViewer")
  colegasQueMeVeem GoogleCalendarColegaVisivel[] @relation("ColegaDono")
  permissaoColegasCalendario GoogleCalendarPermissaoColegas? @relation("PermissaoColegasCalendario")

  confirmacoesLeituraDocumento ConfirmacaoLeituraDocumento[]

  blueprintProjetosSolicitados BlueprintProject[] @relation("BlueprintRequester")
  blueprintProjetosPropriedade BlueprintProject[] @relation("BlueprintOwner")
  blueprintProjetosDesenvolvimento BlueprintProject[] @relation("BlueprintDeveloper")
  blueprintProjetosCriados BlueprintProject[] @relation("BlueprintCreatedBy")
  blueprintMembros BlueprintMember[]

  bpmCardsResponsavel BpmCard[] @relation("BpmCardResponsavel")
  bpmCardMembros      BpmCardMembro[]
  bpmTarefas          BpmTarefa[]
  bpmCardHistorico    BpmCardHistorico[]
  bpmPipelineConfigAuditoria BpmPipelineConfigAuditoria[]
  bpmCardAnexosEnviados BpmCardAnexo[]
}

model OnboardingTemplate {
  id        Int      @id @default(autoincrement())
  nome      String
  setor     String?
  mensagem  String
  ativo     Boolean  @default(true)
  padrao    Boolean  @default(false)
  tipo      String   @default("USUARIO") // USUARIO | PARCEIRO | CLIENTE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_template")
}

model OnboardingLog {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  criadoPorId Int
  templateId  Int?
  tipoEnvio   String
  telefone    String?
  email       String?
  enviadoEm   DateTime @default(now())

  @@index([usuarioId])
  @@map("onboarding_log")
}

model chamados {
  id            Int                @id @default(autoincrement())
  titulo        String
  descricao     String
  categoria     String
  status        String             @default("ABERTO")
  prioridade    String             @default("MEDIA")
  solucao       String?
  causa         String?
  mensagemFinal String?
  templateId    Int?
  closedAt      DateTime?
  usuarioId     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  solicitante   usuarios           @relation("Solicitante", fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagens     MensagensChamado[]

  @@index([usuarioId])
  @@index([status])
}

model ProtocoloTemplate {
  id        Int      @id @default(autoincrement())
  nome      String
  categoria String
  template  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("protocolo_template")
}

model WhatsAppLog {
  id           Int      @id @default(autoincrement())
  chamadoId    Int
  usuarioId    Int
  telefone     String
  mensagem     String
  enviadoPorId Int
  createdAt    DateTime @default(now())

  @@index([chamadoId])
  @@map("whatsapp_log")
}

model consultas_radar {
  id                Int             @id @default(autoincrement())
  cnpj              String          @unique
  razao_social      String?
  nome_fantasia     String?
  situacao_radar    String?
  submodalidade     String?
  data_situacao     DateTime?
  municipio         String?
  uf                String?
  regime_tributario String?
  capital_social    String?
  data_constituicao DateTime?
  contribuinte      String?
  data_consulta     DateTime        @default(now())
  fonte             String
  json_completo     String
  arquivo_id        Int?
  data_opcao        DateTime?
  optante_simples   Boolean?
  arquivo           arquivos_radar? @relation(fields: [arquivo_id], references: [id], onDelete: Cascade)

  @@index([cnpj])
}

model arquivos_radar {
  id              Int               @id @default(autoincrement())
  nome_arquivo    String            @unique
  data_upload     DateTime          @default(now())
  total_registros Int
  registros       consultas_radar[]
}

model reservas {
  id      Int      @id @default(autoincrement())
  sala    String
  usuario String
  data    DateTime
  inicio  DateTime

  motivo      String?
  tipo        String?
  paoDeQueijo Boolean @default(true)

  fim    DateTime?
  status String    @default("Agendado")
}

model documentos {
  id            Int      @id @default(autoincrement())
  titulo        String
  PastaArquivos String?
  url           String
  setor         String
  tipo          String
  data_criacao  DateTime @default(now())
  status        String?  @default("ATIVO")
  criado_por    String?  @default("SISTEMA")
  protecao      String?  @default("ATIVO")
  ordem_manual  Int?     @default(0)

  confirmacoes ConfirmacaoLeituraDocumento[]
}

/// Confirmação de leitura de um documento do POP por um usuário — 1 linha por
/// par (documento, usuário). Alimenta o botão "Confirmar Leitura" no POP e o
/// indicador de documentos lidos no card de cada colaborador em Gestão de
/// Equipe. Criada via script pontual (Vault aprovou 🟢, CREATE TABLE puro),
/// não via `prisma db push` (não alcança o Turso remoto neste projeto).
model ConfirmacaoLeituraDocumento {
  id           Int      @id @default(autoincrement())
  documentoId  Int
  usuarioId    Int
  confirmadoEm DateTime @default(now())

  documento documentos @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   usuarios   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([documentoId, usuarioId])
  @@index([usuarioId])
  @@index([documentoId])
}

model clientes {
  id                  Int                         @id @default(autoincrement())
  status              String                      @default("Em Andamento")
  cnpj                String
  razaoSocial         String
  nomeFantasia        String?
  dataConstituicao    String?
  uf                  String?
  municipio           String?
  regimeTributario    String?
  servicos            String?
  analistaResponsavel String?
  dataContratacao     String?
  dataExito           String?
  formaPagamento      String?
  valorContrato       Float?
  closerNome          String?
  ultimoCs            Int?                        @default(0)
  nps                 Int?
  feedbackGoogle      Boolean                     @default(false)
  createdAt           String?                     @default("")
  updatedAt           String?                     @default("")
  log_cs              log_cs[]
  socios              socios[]
  logFeedback         logFeedback[]
  logAlteracao        logAlteracao[]
  historicoAlteracoes HistoricoAlteracaoCliente[]
  nomeGoogle          String?
  embasamento         String?
  origemLead          String?

  // Canal de aquisição (Painel de Metas) + indicação por parceiro
  canalAquisicao String?
  canalOutro     String?
  indicacao      Indicacao?

  // Alpha BPM (2026-08-03) — reaproveita `clientes` como Empresa do BPM (D-049)
  bpmCards              BpmCard[]
  pessoaEmpresaVinculos PessoaEmpresaVinculo[]

  @@unique([cnpj, servicos])
  @@map("clientes")
}

model socios {
  id             Int     @id @default(autoincrement())
  nome           String
  telefone       String?
  obs            String?
  dataNascimento String?
  vinculo        String?

  clienteId Int
  cliente   clientes @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Alpha BPM (2026-08-03) — reaproveita `socios` como Pessoa do BPM (D-049),
  // vínculo N:N com empresas via PessoaEmpresaVinculo (socios.clienteId continua 1:1, intocado)
  empresaVinculos PessoaEmpresaVinculo[]

  @@map("socios")
}

model log_cs {
  id           Int      @id @default(autoincrement())
  dataRegistro DateTime @default(now())
  colaborador  String
  sentimento   String
  observacao   String?
  clienteId    Int
  clientes     clientes @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("log_cs")
}

model logFeedback {
  id           Int      @id @default(autoincrement())
  dataRegistro DateTime @default(now())
  colaborador  String
  sentimento   String
  observacao   String?
  clienteId    Int
  clientes     clientes @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("logFeedback")
}

model logAlteracao {
  id              Int      @id @default(autoincrement())
  dataAlteracao   DateTime @default(now())
  colaborador     String
  acao            String
  dadosAnteriores String?
  clienteId       Int
  clientes        clientes @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("logAlteracao")
}

/// Reconstrução do log de auditoria do CS&NPS (2026-07-13, ver decisions.md).
/// Substitui `logAlteracao` (desativado, sem gravação nova) por granularidade
/// por campo: cada campo alterado em 1 "Salvar" vira 1 linha, agrupadas por
/// `loteId`. Reversão é por linha/campo específico, nunca o cliente inteiro.
model HistoricoAlteracaoCliente {
  id                 String    @id @default(cuid())
  loteId             String // agrupa todas as linhas de 1 mesma ação de "Salvar"
  clienteId          Int
  cliente            clientes  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campo              String // nome do campo alterado (ex: "status", "analistaResponsavel")
  valorAnterior      String?
  valorNovo          String?
  userId             Int?
  usuario            usuarios? @relation(fields: [userId], references: [id], onDelete: SetNull)
  nomeUsuarioNaEpoca String // snapshot do nome no momento da ação
  acao               String    @default("EDICAO") // "EDICAO" | "REVERSAO"
  criadoEm           DateTime  @default(now())

  @@index([clienteId, criadoEm])
  @@index([loteId])
  @@map("historico_alteracao_cliente")
}

model ordemPastas {
  id        Int     @id @default(autoincrement())
  setor     String  @unique
  ordem     String
  createdAt String?
  updatedAt String?
}

model MensagensChamado {
  id        Int      @id @default(autoincrement())
  texto     String?
  createdAt DateTime @default(now())

  chamado   chamados @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  chamadoId Int

  lida_admin   Boolean @default(false)
  lida_usuario Boolean @default(false)

  arquivoUrl  String?
  arquivoTipo String?

  autor   usuarios @relation(fields: [autorId], references: [id])
  autorId Int
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  userId    Int
  acao      String
  detalhes  String?
  ip        String?
  createdAt DateTime @default(now())

  usuario usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model avisos_globais {
  id        Int      @id @default(autoincrement())
  mensagem  String
  ativo     Boolean  @default(true)
  tipo      String   @default("warning")
  criado_em DateTime @default(now())
}

model colaboradores_core {
  id               Int     @id @default(autoincrement())
  nome             String
  setor            String
  cargo            String
  data_contratacao String?
  status           String? @default("ATIVO")
  criado_em        String?
}

model sistemas_core {
  id        Int     @id @default(autoincrement())
  nome      String
  link      String
  icone     String? @default("google")
  criado_em String?

  recursos vault_recursos[]
}

model vault_recursos {
  id             Int     @id @default(autoincrement())
  colaborador_id String
  sistema_id     Int
  login          String
  senha          String
  criado_em      String?

  sistema sistemas_core @relation(fields: [sistema_id], references: [id])
}

model radar_fiscal {
  id                 Int     @id @default(autoincrement())
  cnpj               String  @unique
  razao_social       String?
  nome_fantasia      String?
  qualificacao       String?
  situacao_cadastral String?
  municipio          String?
  uf                 String?
  data_abertura      String?
  capital_social     String?

  regime_receita        String?
  regime_ea             String?
  data_opcao_simples    String?
  data_exclusao_simples String?
  divida_tributaria     Float?  @default(0)

  historico_regime String?
  cnaes            String?
  qsa              String?

  data_consulta String?
  perse_anexo   String?
  perse         String?
  perse_motivo  String?
  fonte         String? @default("API")
}

model historico_planilha_fiscal {
  id      Int      @id @default(autoincrement())
  nome    String
  arquivo Bytes
  data    DateTime @default(now())
}

model mensagens {
  id             Int      @id @default(autoincrement())
  texto          String
  remetenteId    Int
  destinatarioId Int
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())

  remetente    usuarios @relation("Enviadas", fields: [remetenteId], references: [id])
  destinatario usuarios @relation("Recebidas", fields: [destinatarioId], references: [id])
}

model conversas {
  id        Int      @id @default(autoincrement())
  p1Id      Int
  p2Id      Int
  ultimaMsg String?
  updatedAt DateTime @default(now())

  user1 usuarios @relation("ConversaP1", fields: [p1Id], references: [id])
  user2 usuarios @relation("ConversaP2", fields: [p2Id], references: [id])

  @@unique([p1Id, p2Id])
}

model Extratos {
  id               Int     @id @default(autoincrement())
  cnpj             String  @unique
  razaoSocial      String
  nomeFantasia     String?
  dataConstituicao String?
  municipio        String?
  uf               String?
  regimeTributario String?

  criadoPorNome String?
  periodos      PeriodosAnalise[]

  analistaResponsavel String?
  dataExito           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([criadoPorNome])
  @@index([razaoSocial])
  @@map("Extratos")
}

model BancosVinculados {
  id        Int     @id @default(autoincrement())
  bancoId   String
  nomeBanco String
  logo      String
  descricao String?
  anotacao  String?
  status    String  @default("Ativo / Sincronizado")

  periodoId Int
  periodo   PeriodosAnalise @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transacoes Transacao[]

  @@map("BancosVinculados")
}

model PeriodosAnalise {
  id  Int    @id @default(autoincrement())
  mes String
  ano String

  extratoId Int
  empresa   Extratos @relation(fields: [extratoId], references: [id], onDelete: Cascade)

  bancos BancosVinculados[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PeriodosAnalise")
}

model Transacao {
  id                String    @id @default(cuid())
  data              DateTime?
  dataOriginalTexto String?
  descricao         String
  valor             Float
  bancoId           String
  mesReferencia     String
  origemArquivo     String?
  createdAt         DateTime  @default(now())

  BancosVinculadosId Int
  BancosVinculados   BancosVinculados @relation(fields: [BancosVinculadosId], references: [id], onDelete: Cascade)

  @@index([BancosVinculadosId, data])
}

model Tarefa {
  id         String  @id @default(cuid())
  texto      String
  descricao  String?
  fixa       Boolean @default(false)
  feita      Boolean @default(false)
  prioridade String

  diaSemana     Int?
  intervaloDias Int?
  dataInicio    DateTime? @default(now())
  horario       String?

  userId   Int
  usuarios usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidaEm DateTime?

  id_produto String? @unique

  @@index([userId])
}

model DiretrizSala {
  id        Int      @id @default(autoincrement())
  sala      String   @unique
  descricao String   @default("")
  updatedAt DateTime @updatedAt
}

model Categoria {
  id           String           @id @default(uuid())
  nome         String           @unique
  cor          String?          @default("#6366f1")
  icone        String?          @default("Package")
  produtos     ProdutoEstoque[]
  listaCompras ListaCompra[]
  createdAt    DateTime         @default(now())
}

model ProdutoEstoque {
  id            String    @id @default(uuid())
  imagem        String?
  nome          String
  quantidade    Int       @default(0)
  estoqueMinimo Int       @default(1)
  unidade       String
  precoMedio    Float?    @default(0)
  ultimaCompra  DateTime?

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListaCompra {
  id              String   @id @default(uuid())
  produtoId       String   @unique
  nome            String
  quantidadeAtual Int
  minimoEsperado  Int
  unidade         String
  status          String   @default("CARRINHO")
  createdAt       DateTime @default(now())

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
}

model ConsultaPreAnalise {
  id           String  @id @default(cuid())
  cnpj         String  @unique
  razaoSocial  String
  nomeFantasia String?
  situacao     String?
  uf           String?
  municipio    String?

  regimeEA      String?
  qualificacao  String?
  submodalidade String?
  capitalSocial Float?

  dadosBrutos Json

  nomeResponsavel String?
  telefoneContato String?
  observacoes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cnpj])
  @@index([razaoSocial])
}

model videos {
  id        String  @id @default(cuid())
  titulo    String
  descricao String?
  url       String
  thumbUrl  String?
  tamanho   String?
  duracao   Float?
  setor     String
  ordem     Int?    @default(0)

  modulo ModuloVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presets    Preset[]         @relation("PresetVideos")
  progressos ProgressoVideo[]

  configsIntrodutorio VideoIntrodutorioConfig[]

  @@map("videos")
}

model VideoIntrodutorioConfig {
  id           String    @id @default(cuid())
  modulo       String    @unique
  videoId      String?
  video        videos?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  ativadoEm    DateTime?
  ativadoPorId Int?
  ativadoPor   usuarios? @relation(fields: [ativadoPorId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("video_introdutorio_config")
}

model modulos {
  id          String  @id @default(cuid())
  nome        String  @unique
  descricao   String?
  aprendizado String?
  imagemUrl   String?
  setor       String

  bloqueado        Boolean @default(false)
  requerModuloId   String?
  percentualMinimo Int

  videos ModuloVideo[]
  cursos CursoModulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modulos")
}

model ModuloVideo {
  moduloId String
  videoId  String
  ordem    Int    @default(0)

  modulo modulos @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  video  videos  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([moduloId, videoId])
  @@map("_ModuloVideos")
}

model Curso {
  id        String        @id @default(cuid())
  nome      String        @unique
  descricao String?
  capa      String?
  ordem     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  setores   CursoSetor[]
  modulos   CursoModulo[]

  @@index([ordem])
}

model CursoSetor {
  id      String @id @default(cuid())
  cursoId String
  setor   String
  curso   Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, setor])
  @@index([setor])
}

model CursoModulo {
  id       String  @id @default(cuid())
  cursoId  String
  moduloId String
  ordem    Int     @default(0)
  curso    Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
