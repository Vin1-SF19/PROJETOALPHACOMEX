  syncRun      SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  sourceEntity String
  sourceId     String
  mensagem     String
  detalhesJson String?
  createdAt    DateTime @default(now())

  @@index([syncRunId])
}

model CommissionRule {
  id               String   @id @default(cuid())
  name             String
  description      String?
  active           Boolean  @default(true)
  priority         Int      @default(0)
  eventType        String
  benefitType      String // COMMISSION|BONUS|DSR
  cargoId          Int?
  setorId          Int?
  collaboratorId   Int?
  servico          String?
  approvalRequired Boolean  @default(false)
  createdById      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versoes CommissionRuleVersion[]
}

model CommissionRuleVersion {
  id                  String         @id @default(cuid())
  ruleId              String
  rule                CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version             Int
  status              String         @default("DRAFT") // DRAFT|PUBLISHED|INACTIVE
  validFrom           DateTime
  validTo             DateTime?
  conditionsJson      String
  calculationJson     String
  paymentScheduleJson String
  publishedById       Int?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())

  @@unique([ruleId, version])
}

model EligibilityOverride {
  id             String @id @default(cuid())
  collaboratorId Int?
  cargoId        Int?

  // Fase 3.7 do Cliente Master (2026-08-14): mesma dupla clienteServicoId/clienteId, aplicada
  // por consistência mesmo sem dado real hoje (campo nunca exposto pela UI de exceções).
  clienteServicoId Int?
  clienteServico   ClienteServico? @relation(fields: [clienteServicoId], references: [id])
  clienteId        Int?
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])

  contratoComercialId String?
  contratoComercial   ContratoComercial? @relation(fields: [contratoComercialId], references: [id])

  servico              String? // filtro de elegibilidade, não snapshot histórico
  eventType            String?
  dataInicial          DateTime?
  dataFinal            DateTime?
  tipo                 String // BLOQUEIO|SUBSTITUICAO|PERCENTUAL_ESPECIFICO|VALOR_ESPECIFICO|EXCLUSAO
  percentualEspecifico Float?
  valorEspecificoCents Int?
  justificativa        String
  prioridade           Int       @default(0)
  approvalRequired     Boolean   @default(false)
  aprovadoById         Int?
  aprovadoEm           DateTime?
  createdById          Int
  createdAt            DateTime  @default(now())

  @@index([clienteServicoId])
  @@index([clienteId])
  @@index([contratoComercialId])
}

model CommissionEntry {
  id             String          @id @default(cuid())
  eventId        String
  event          CommissionEvent @relation(fields: [eventId], references: [id])
  collaboratorId Int
  cargoId        Int
  vinculo        String // "CLT" | "PJ" resolvido na data do evento
  ruleVersionId  String?

  totalCents Int    @default(0)
  status     String @default("Pendente") // Pendente|AguardandoAprovacao|Programado|Pago|ParcialmentePago|Vencido|Bloqueado|EmDivergencia|Cancelado|Estornado

  contractualDueDate       DateTime?
  operationalSuggestedDate DateTime?
  scheduledPaymentDate     DateTime?
  actualPaymentDate        DateTime?

  componentes EntryComponent[]
  ajustes     ManualAdjustment[]
  alocacoes   PaymentAllocation[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([eventId, collaboratorId])
  @@index([collaboratorId])
  @@index([status])
}

model EntryComponent {
  id                 String          @id @default(cuid())
  entryId            String
  entry              CommissionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tipo               String // COMISSAO|PREMIO|DSR|AJUSTE
