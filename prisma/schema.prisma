/// Objetivo priorizado do Roadmap Alpha. O registry de módulos vive em código;
/// os snapshots preservam o rótulo e a categoria vistos na criação.
model RoadmapObjective {
  id                     String  @id @default(cuid())
  code                   String  @unique
  moduleKey              String
  moduleLabelSnapshot    String
  moduleCategorySnapshot String
  title                  String
  description            String
  desiredOutcome         String?
  constraints            String?
  acceptanceCriteriaJson String
  globalPriority         Int     @unique
  status                 String  @default("ACTIVE")
  documentationStatus    String  @default("PENDING")
  sourceVersion          Int     @default(1)
  isNewModule            Boolean @default(false)
  developmentAssignee    String  @default("claude")
  // "claude" | "codex" — quem executa as fases deste objetivo (novo motor de
  // status manual). Qwen/Ollama não é mais uma opção: não há motor de IA
  // autônomo rodando dentro do painel.

  createdById Int
  createdBy   usuarios @relation(fields: [createdById], references: [id], onDelete: Restrict)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relatório de conclusão (Fase 11 — Kowalski/arquivamento). Markdown completo, sem o limite de
  // 4000 caracteres de RoadmapProductionRun.resultSummary — gravado via tool MCP dedicada
  // (roadmap_registrar_relatorio_conclusao), exibido em modal read-only na UI de Produção.
  completionReportMarkdown    String?
  completionReportGeneratedAt DateTime?

  documentationJobs RoadmapDocumentationJob[]
  promptArtifacts   RoadmapPromptArtifact[]
  productionRuns    RoadmapProductionRun[]

  @@index([archivedAt, globalPriority, createdAt, id])
  @@index([moduleKey, archivedAt, globalPriority, createdAt, id])
  @@index([documentationStatus, globalPriority, createdAt, id])
}

/// Job idempotente de documentação. Lease, heartbeat e claimToken fornecem
/// exclusão distribuída e fencing para o worker contínuo.
model RoadmapDocumentationJob {
  id               String           @id @default(cuid())
  objectiveId      String
  objective        RoadmapObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  sourceVersion    Int
  idempotencyKey   String           @unique
  status           String           @default("PENDING")
  prioritySnapshot Int
  availableAt      DateTime         @default(now())
  attemptCount     Int              @default(0)
  maxAttempts      Int              @default(5)

  claimedBy      String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  heartbeatAt    DateTime?
  claimToken     Int       @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?
  deadLetteredAt   DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attempts  RoadmapDocumentationAttempt[]
  artifacts RoadmapPromptArtifact[]

  @@unique([objectiveId, sourceVersion])
  @@index([status, availableAt, prioritySnapshot, createdAt, id])
  @@index([status, claimExpiresAt])
  @@index([objectiveId, status])
}

/// Lock global singleton (id fixo "singleton") que garante processamento
/// estritamente sequencial da fila de documentação — no máximo 1 objetivo em
/// DOCUMENTING por vez, mesmo que múltiplos processos worker (ou o mesmo
/// worker chamado fora do supervisor .ps1, de outra máquina, etc.) tentem
/// reivindicar jobs ao mesmo tempo. RoadmapDocumentationJob.claimToken já
/// protege contra double-claim do MESMO job; este lock protege contra dois
/// jobs DIFERENTES sendo processados ao mesmo tempo. Mesmo padrão de fencing
/// otimista (claimToken incremental) já usado em RoadmapDocumentationJob.
model RoadmapDocumentationWorkerLock {
  id             String    @id @default("singleton")
  claimedBy      String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  heartbeatAt    DateTime?
  claimToken     Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// Tentativa sanitizada de chamada ao provedor. Tokens, URLs autenticadas e
/// respostas brutas nunca são armazenados.
model RoadmapDocumentationAttempt {
  id             String                  @id @default(cuid())
  jobId          String
  job            RoadmapDocumentationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  provider       String
  model          String
  status         String
  startedAt      DateTime                @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  httpStatus     Int?
  errorCode      String?
  errorMessage   String?
  responseSha256 String?
  createdAt      DateTime                @default(now())

  artifacts RoadmapPromptArtifact[]

  @@unique([jobId, attemptNumber])
  @@index([jobId, status])
}

/// Conteúdo Markdown canônico; o filesystem em prompt-phases é uma projeção
/// reconciliável e nunca a fonte primária.
model RoadmapPromptArtifact {
  id                   String                       @id @default(cuid())
  objectiveId          String
  objective            RoadmapObjective             @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  jobId                String
  job                  RoadmapDocumentationJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptId            String?
  attempt              RoadmapDocumentationAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  documentationVersion Int
  phaseNumber          Int
  slug                 String
  title                String
  kind                 String
  agent                String
  dependsOnJson        String
  contentMarkdown      String
  relativePath         String?
  sha256               String
  status               String                       @default("DRAFT")
  publishedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  productionRuns RoadmapProductionRun[]

  @@unique([objectiveId, documentationVersion, phaseNumber])
  @@index([jobId, phaseNumber])
  @@index([attemptId])
  @@index([objectiveId, status])
}

/// Projeto externo registrado para desenvolvimento autônomo via Roadmap Alpha.
/// rootPath é escolhido pelo usuário por navegador de diretório server-side
/// (nunca digitado livremente) e revalidado a cada leitura — nunca confiar em
/// path armazenado sem checar de novo que ainda existe e é um diretório real.
model RoadmapWorkspace {
  id              String    @id @default(cuid())
  moduleKey       String    @unique
  label           String
  rootPath        String
  status          String    @default("ATIVO")
  createdById     Int
  createdBy       usuarios  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  workerPid       Int?
  workerStartedAt DateTime?

  @@index([status, createdAt, id])
}

/// Estado de execução de UMA fase (objectiveId+sourceVersion+phaseNumber) no
/// paradigma de status manual: quem implementa é um humano/agente externo
/// (Claude ou Codex, via chat) reportando progresso pela rota HTTP
/// /api/roadmap/production — substitui por completo o antigo motor autônomo
/// (agent loop + estado em JSON). "Execução" (antigo executionId derivado)
/// agora é implícita: o conjunto de runs de um objectiveId+sourceVersion.
model RoadmapProductionRun {
  id            String                 @id @default(cuid())
  objectiveId   String
  objective     RoadmapObjective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  sourceVersion Int
  phaseNumber   Int
  artifactId    String?
  artifact      RoadmapPromptArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  status   String @default("PENDING")
  // PENDING | AWAITING_APPROVAL | IN_PROGRESS | NEEDS_INPUT | BLOCKED | SUCCEEDED | FAILED | CANCELLED
  assignee String @default("claude")
  // "claude" | "codex" | "manual"

  approvedById Int?
  approvedBy   usuarios? @relation("RoadmapProductionRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  startedAt        DateTime?
  finishedAt       DateTime?
  resultSummary    String?
  errorCode        String?
  changedFilesJson String?

  createdById Int
  createdBy   usuarios @relation("RoadmapProductionRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events RoadmapProductionEvent[]

  @@unique([objectiveId, sourceVersion, phaseNumber])
  @@index([status, updatedAt, id])
  @@index([objectiveId, status])
}

/// Log append-only de tudo que acontece numa RoadmapProductionRun: mudanças
/// de status, mensagens/perguntas/notas registradas via chat. Nunca editado.
model RoadmapProductionEvent {
  id    String               @id @default(cuid())
  runId String
  run   RoadmapProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  kind       String
  // STATUS_CHANGE | MESSAGE | QUESTION | ANSWER | NOTE
  fromStatus String?
  toStatus   String?
  content    String?

  authorKind   String
  // "user" | "assistant" | "system"
  authorLabel  String
  authorUserId Int?
  authorUser   usuarios? @relation("RoadmapProductionEventAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([runId, createdAt, id])
}

/// Credencial de API dedicada ao uso do MCP local (Claude Code/Codex) contra
/// /api/roadmap/production/*. Mesmo padrão de AlphaSeoApiKey: token nunca
/// armazenado em claro, só keyHash (SHA-256); prefixo identificável exibido
/// ao usuário para reconhecer a key sem expor o segredo.
model RoadmapApiKey {
  id         String  @id @default(cuid())
  label      String
  keyHash    String  @unique
  prefix     String
  scopesJson String
  // JSON array: ["roadmap:read","roadmap:write"]
  enabled    Boolean @default(true)

  createdById Int
  createdBy   usuarios @relation("RoadmapApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  expiresAt DateTime?
  revokedAt DateTime?

  rateLimitWindowMs Int       @default(60000)
  rateLimitMax      Int       @default(120)
  requestCount      Int       @default(0)
  lastRequestAt     DateTime?
  lastUsedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([enabled, revokedAt])
}

