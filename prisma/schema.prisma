// Fase 3.3 do Cliente Master (2026-08-13) — campos cadastrais de empresa
// (cnpj/razaoSocial/nomeFantasia/dataConstituicao/municipio/uf/regimeTributario)
// removidos, substituídos por `clienteId @unique → Cliente`. Extratos não cria
// Cliente novo — só vincula empresa já cadastrada (mesma regra dos demais
// módulos satélite; BPM é a única porta de entrada de Cliente novo).
model Extratos {
  id        Int     @id @default(autoincrement())
  clienteId Int     @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  criadoPorNome String?
