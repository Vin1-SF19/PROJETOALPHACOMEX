model ContratoComercial {
  id String @id @default(cuid())

  // Fase 3.6 do Cliente Master (2026-08-14): cnpj/razaoSocial/nomeFantasia/
  // dataConstituicao/regimeTributario/uf deixaram de existir aqui — vêm sempre
  // via include: { cliente }. Diferente de Extratos/Operacional (busca-e-bloqueia),
  // aqui `clienteId` é resolvido OU CRIADO por criarContrato: o BPM ainda não é a
  // porta de entrada real de Cliente novo (time comercial usa CRM externo hoje,
  // enquanto o BPM não está em uso operacional) — bloquear quebraria o fluxo
  // comercial diário. Ajuste futuro (fora desta fase) quando o BPM assumir esse
  // papel de verdade: trocar para busca-e-bloqueia, igual às demais fases satélite.
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  valorContrato         Float
  formaPagamento        String
  servico               String
  canalAquisicao        String
  canalOutro            String? // texto livre quando canal = "Outro"
  indicadoPorParceiroId Int? // parceiro indicador quando canal = "Indicação Parceiro"

  closerNome String

  status String @default("ENVIADO")

  pagamentoConfirmado   Boolean   @default(false)
  pagamentoConfirmadoEm DateTime?

  contratoAssinado Boolean @default(false)
  contratoUrl      String?

  contaComVenda Boolean @default(true)

  arquivado   Boolean   @default(false)
  arquivadoEm DateTime?

  socios Json?

  mes Int
  ano Int

  usuarioId   Int
  usuario     usuarios             @relation("ContratosComerciais", fields: [usuarioId], references: [id], onDelete: Cascade)
  observacoes ObservacaoContrato[]

  commissionEvents     CommissionEvent[]
  businessProcesses    BusinessProcess[]
  eligibilityOverrides EligibilityOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([mes, ano])
  @@index([status])
  @@index([clienteId])
  @@map("contratos_comerciais")
}

