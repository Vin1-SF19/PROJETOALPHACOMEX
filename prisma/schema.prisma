model OperacionalClientes {
  id           String  @id @default(cuid())
  status       String  @default("ATIVO")
  embasamento  String
  progresso    Int     @default(0)
  mesProtocolo String?
  linkGrupo    String?

  tipo TipoEmbasamento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fase 3.5 do Cliente Master (2026-08-13): campo antigo `clienteId/cliente` (conta de
  // login do portal) renomeado para `clienteOperacionalId/clienteOperacional` para abrir
  // espaço ao novo `clienteId/cliente` abaixo, que aponta para o Cliente master (empresa).
  clienteOperacionalId String
  clienteOperacional   ClienteOperacional @relation(fields: [clienteOperacionalId], references: [id])

  // Cliente master (empresa) — obrigatório, sem criação automática (vincularEmpresaAoCliente
  // busca por CNPJ e bloqueia se não encontrar). razaoSocial/nomeFantasia/cnpj/situacaoRadar/
  // submodalidade/municipio/uf/regimeTributario/capitalSocial/dataConstituicao/contribuinte/
  // dataSituacao deixaram de existir aqui — vêm sempre via include: { cliente }.
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  pastaChecklistId String?
  pastaChecklist   PastaChecklist?    @relation(fields: [pastaChecklistId], references: [id])
  documentos       DocumentoUnidade[]
  checklists       Checklist[]

  @@index([pastaChecklistId])
  @@index([clienteId])
  @@map("operacional_clientes")
}

